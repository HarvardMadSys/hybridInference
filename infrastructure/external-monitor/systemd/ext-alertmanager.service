[Unit]
Description=Alertmanager (External Probe)
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/alertmanager \
    --config.file=/etc/external-monitor/alertmanager.yml \
    --storage.path=/var/lib/ext-alertmanager \
    --web.listen-address=127.0.0.1:9093
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
