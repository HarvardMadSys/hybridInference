  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["hybrid-inference", "overview"],
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "route",
        "type": "query",
        "datasource": "${DS_PROMETHEUS}",
        "query": "label_values(api_requests_total, route)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {"selected": false}
      },
      {
        "name": "method",
        "label": "method",
        "type": "query",
        "datasource": "${DS_PROMETHEUS}",
        "query": "label_values(api_requests_total, method)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {"selected": false}
      },
      {
        "name": "stream",
        "label": "stream",
        "type": "query",
        "datasource": "${DS_PROMETHEUS}",
        "query": "label_values(api_requests_total, stream)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {"selected": false}
      },
      {
        "name": "provider",
        "label": "provider",
        "type": "query",
        "datasource": "${DS_PROMETHEUS}",
        "query": "label_values(provider_request_duration_seconds_bucket, provider)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {"selected": false}
      },
      {
        "name": "model",
        "label": "model",
        "type": "query",
        "datasource": "${DS_PROMETHEUS}",
        "query": "label_values(api_tokens_total, model)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {"selected": false}
      }
    ]
  },
  "time": {
    "from": "now-2d",
    "to": "now"
  },
