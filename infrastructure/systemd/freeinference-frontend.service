[Unit]
Description=FreeInference Frontend (Next.js)
After=network.target

[Service]
Type=simple
User=murphy
Group=murphy
WorkingDirectory=/home/murphy/hybridInference/frontend

# Environment variables
Environment=NODE_ENV=production
Environment=PORT=3001

# Use node directly from nvm
ExecStart=/home/murphy/.nvm/versions/node/v22.19.0/bin/node /home/murphy/hybridInference/frontend/node_modules/.bin/next start -p 3001

# Restart policy
Restart=always
RestartSec=10

# Resource limits
LimitNOFILE=65536

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=freeinference-frontend

# Process management
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
