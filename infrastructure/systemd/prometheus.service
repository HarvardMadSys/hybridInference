[Unit]
Description=Prometheus
Wants=network-online.target
After=network-online.target home.mount

[Service]
User=freeinference
Group=freeinference
Type=simple
ExecStart=/srv/hybridInference/prometheus \
  --config.file=/srv/hybridInference/infrastructure/prometheus/prometheus.yml \
  --storage.tsdb.path=/srv/hybridInference/var/prometheus \
  --web.listen-address=0.0.0.0:9090 \
  --web.enable-lifecycle
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536

NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
