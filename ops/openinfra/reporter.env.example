# /etc/openinfra/reporter.env, read by openinfra-reporter.service.
# Keep it readable by root and the reporter's group only: it holds the token.

# The gateway: the public site, or the backend's address on a private network.
# The reporter posts to $OPENINFRA_URL/internal/openinfra/ingest.
OPENINFRA_URL=https://gateway.example.org

# The gateway's OPENINFRA_INGEST_TOKEN (Admin > Settings > Site & Setup > Integrations).
OPENINFRA_TOKEN=

# This host's identity and engines; start from node.example.json.
OPENINFRA_NODE_CONFIG=/etc/openinfra/node.json
