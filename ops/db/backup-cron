# Daily database backup to S3 — runs at 04:00 UTC
# Install: sudo cp ops/db/backup-cron /etc/cron.d/freeinference-backup && sudo sed -i 's|scripts/db|ops/db|' /etc/cron.d/freeinference-backup
# Requires: freeinference user in docker group (sudo usermod -aG docker freeinference)
#
# Retention: 3 daily + 2 weekly + 1 monthly (GFS rotation)
# Logs:      ~freeinference/backup.log (writable without root)

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
HOME=/home/freeinference

0 4 * * * freeinference /srv/hybridInference/ops/db/backup.sh --compress --s3-bucket s3://freeinference/backup --s3-only >> /home/freeinference/backup.log 2>&1
