settings:
  port: 9101
  # Optional path prefix for reverse-proxy deployments (e.g. "/status-monitor").
  base_path: ""
  default_timeout: 30
  probe_prompt: "Write a short Python function that returns hello world."
  probe_max_tokens: 32
  probe_temperature: 0
  history_size: 100
  log_level: "INFO"
  # Where to persist recent history so a restart does not lose it.
  state_path: "./state/status-monitor-state.json"
  # Bounded probe fan-out. The gateway caps per-user concurrency (3 free/pro,
  # 10 internal/admin) and 429s the excess. Keep at/below the prober account cap.
  max_concurrency: 3
  # Role of the PROBER_API_KEY account. Models whose required_role outranks this
  # are skipped (the gateway 404s them). One of: free, pro, internal, admin.
  prober_role: "internal"

gateway:
  base_url: "http://localhost:8080"
  api_key: "${PROBER_API_KEY}"
  # Probe every model every 5 minutes.
  e2e_interval: 300
  # Marks requests as synthetic so they can be excluded from analytics/billing.
  probe_header: "synthetic"
  # Discover targets from the gateway's authenticated /models catalog (reflects
  # role + runtime visibility overrides). Falls back to the static registry
  # below if discovery fails or this is disabled.
  discover_models: true

registry:
  # Static fallback model registry, used when gateway discovery is unavailable.
  path: "../../config/models.yaml"

# Manual overrides/additions. These take priority over auto-discovered entries
# (matched by model_id). Use probe_max_tokens to give thinking models enough
# budget for visible output.
e2e_models:
  - model_id: minimax-m2.5
    streaming: true
    probe_max_tokens: 256
  - model_id: minimax-m2.7
    streaming: true
    probe_max_tokens: 256
