{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    // `scripts/` runs under `node --experimental-strip-types`, which needs the
    // explicit .ts specifier that Bundler resolution also accepts.
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true
  },
  // `scripts/` and the config-drift test run under Node, not workerd, so they
  // typecheck separately against Node types — see tsconfig.node.json. Keeping
  // them out here is what stops `src/` from silently type-checking against Node
  // globals this Worker does not have at runtime.
  "include": ["src", "test"],
  "exclude": ["test/wrangler-environments.test.ts"]
}
