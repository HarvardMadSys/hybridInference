{
  "name": "status-monitor-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker that probes every FreeInference model on a cron schedule and serves a status dashboard.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply freeinference-monitor --local",
    "migrate:remote": "wrangler d1 migrations apply freeinference-monitor --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250620.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "wrangler": "^3.80.0"
  }
}
