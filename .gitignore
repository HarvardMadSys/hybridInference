# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# Distribution / packaging
build/
dist/
*.egg-info/

# Unit test / coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
.pytest_cache/

# Translations
*.mo
*.pot

# Sphinx documentation
docs/build/
# Extracted catalog templates: regenerated by `make docs-gettext`. The
# translations themselves (docs/developer/locale/**/*.po) are committed.
docs/gettext/

# Jupyter Notebook
.ipynb_checkpoints

# Environments
.env
.venv
env/
venv/

.claude/*

# Private working notes that have never been committed and must not start.
#
# The pre-publication audit lists "untracked stray files" as a category to
# check, and these are what it means: business correspondence naming people
# outside this project, and an agent's scratch memory. Neither is in the history, so a git-based export cannot carry them —
# but nothing stopped a `git add .` from committing them, and a directory-copy
# export would sweep them up. Ignoring them closes both.
docs/collaboration/
.workbuddy/

# Runtime data directories (var/)
var/**
!var/.gitkeep
!var/data/
var/data/**
!var/data/.gitkeep

# The backend's own log file, when LOG_FILE names one (.env.example)
server.log

# Ruff cache
.ruff_cache/

# VS Code / Cursor
.vscode/
.cursor/
.superpowers/

# macOS
.DS_Store

# Temporary files
*.tmp
*.bak
*~
*.db-journal

# IDE specific
.idea/


# ============================================
# Node.js / Frontend (Next.js) specific
# ============================================

# Dependencies
node_modules/

# Next.js build output
.next/

# Site UI resolution output (written by apps/frontend/src/site-ui/resolve.js).
#
# A *view* of which UI the build compiled in, regenerated on every `next`
# command and every Vitest run. Not sources: committing them would pin one
# distribution's module path into the shared repository, and the next default
# build would read the previous distribution's configuration.
apps/frontend/src/generated/
apps/frontend/src/site-ui/active/
apps/frontend/tsconfig.generated.json
# The staged copy of an external module. The container build writes it and
# removes the source context immediately afterwards; a local build writes it
# from a directory on the developer's machine. Either way it is a copy of
# somebody else's tree, never this repository's source.
apps/frontend/src/site-ui/external/

# Testing
coverage/

# Environment variables
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.local

# Logs
npm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Optional eslint cache
.eslintcache

.MEMORY/

.worktrees/
.kilo/workspaces
api_log*.jsonl
api_log*.jsonl.zst

# Written by `prepare-module.mjs prepare` so the in-container build can source
# the module selection. It is generated per build and carries absolute paths
# from whichever machine produced it, so it is never committed.
apps/frontend/.site-ui-build-env

# Host-local lifecycle selection and release history.
.ops.env
.ops/
*.dump
