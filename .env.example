# ============================================================
# hybridInference Environment Variables
# ============================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# See docs for variable descriptions.
#
# Required for `make up` (Docker Compose):
#   DB_NAME, DB_USER, DB_PASSWORD, JWT_SECRET_KEY, API_KEY_SECRET
#
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================================

# --- LLM Provider API Keys ---
LLAMA_API_KEY=
LLAMA_BASE_URL=https://api.llama.com/compat/v1
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
ZAI_API_KEY=
# Optional additional Z.AI key(s) for the inference key pool. Wired into each
# zai route's `api_keys:` in the distribution's models.yaml, so ZAI_API_KEY2 is
# only used once listed there. Selection is sequential failover: ZAI_API_KEY
# serves all traffic until it hits a 429/quota/auth/5xx error and is muted
# (~5 min), then ZAI_API_KEY2 takes over — not a round-robin load split. Blank
# values are ignored.
ZAI_API_KEY2=
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4/

# Kimi (Moonshot) — Kimi Code coding-plan subscription (flat fee).
# OpenAI-compatible endpoint; key from the Kimi Code console.
KIMI_CODING_BASE_URL=https://api.kimi.com/coding/v1
KIMI_CODING_API_KEY=
# Kimi (Moonshot) — pay-per-token API used as a metered fallback.
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_API_KEY=

OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
# Admin quota tab: Ollama Cloud has no official account-usage API yet
# (ollama/ollama#15663). The tab tries OLLAMA_API_KEY (Bearer auth) against
# OLLAMA_USAGE_URL first — a forward-looking probe that 404s today — then falls
# back to scraping the signed-in dashboard with OLLAMA_SESSION_COOKIE, a browser
# session cookie that expires and must be re-pasted periodically.
OLLAMA_SESSION_COOKIE=
# OLLAMA_USAGE_URL=https://ollama.com/api/account/usage

# External Providers
CHUTES_BASE_URL=https://llm.chutes.ai
CHUTES_API_KEY=

FEATHERLESS_BASE_URL=https://api.featherless.ai
FEATHERLESS_API_KEY=

MINIMAX_API_KEY=
# Optional additional MiniMax keys for the inference key pool (round-robin /
# 429 failover). Numbered suffixes are scanned in order (KEY2, KEY3, ...) and
# blank values are ignored. Also consumed by the admin quota tab.
MINIMAX_API_KEY2=
MINIMAX_BASE_URL=https://api.minimax.io/v1
# Admin quota tab: MINIMAX_API_KEY (coding/token-plan key) is the preferred auth
# and queries /token_plan/remains. The session cookie below is a legacy fallback
# used only when no API key is set; it expires and must be re-pasted periodically.
MINIMAX_SESSION_COOKIE=
MINIMAX_GROUP_ID=

# Local self-hosted endpoints (Docker: host machine reachable via host.docker.internal)
LOCAL_OLLAMA_BASE_URL=http://host.docker.internal:8001/v1
CLI_PROXY_BASE_URL=http://host.docker.internal:8317
CLI_PROXY_API_KEY=

# OpenRouter (https://openrouter.ai) — used when models route through
# `kind: openrouter` or `kind: openrouter[<provider_slug>]`.
OPENROUTER_API_KEY=

# Canary gateway. A distribution may wire a second deployment of itself as a
# tiny (weight 0.01) OpenAI-compatible fallback on chat models in its own
# models.yaml, where that base_url is written. Such routes are marked
# `optional: true`, so when this key is blank the canary is skipped at load and
# the rest of each model stays available — which is also why the canary
# deployment itself leaves it unset, so it cannot route traffic back to itself.
STAGING_API_KEY=

# Legacy/unused: keep unset unless older local tooling explicitly needs it.
# (Left blank on purpose — a copied-in hostname would point a new deployment
# at somebody else's gateway.)
LOCAL_BASE_URL=

# Local self-hosted SGLang/vLLM deployment reached by the backend container.
LOCAL_DEPLOYMENT_URL=http://host.docker.internal:8001/v1

# DGX Spark vLLM idle proxy (ops/spark_idle_proxy), reverse-tunneled on port 8002.
SPARK_DEPLOYMENT_URL=http://host.docker.internal:8002/v1

# H200 idle proxies (ops/h200_idle_proxy) — DeepSeek-V4-Flash-0731, sglang TP=2
# with DSpark speculative decoding, reverse-tunneled to both staging and production.
# The unsuffixed var is h200a replica A, kept unsuffixed so gateways set up for the
# earlier single-node deployment keep working. Unset or set to empty to skip that
# endpoint's optional sglang route (copying these defaults enables all three).
#
#   H200_DEPLOYMENT_URL    h200a replica A — port 8003, GPUs 2,3
#   H200A2_DEPLOYMENT_URL  h200a replica B — port 8005, GPUs 0,1
#   H200B_DEPLOYMENT_URL   h200b           — port 8004, GPUs 2,3
#
# A 4xH200 box runs two TP=2 replicas rather than one TP=4 instance because TP=4
# scales at only ~0.71 efficiency on these cards: measured on h200a, one TP=2
# replica does 4,215 decode tok/s at c=128 against TP=4's 6,014, so two project to
# ~8,430 (+40%). Each replica needs its own route here — one route reaches one
# replica, and it is the gateway's weighted-random selection across routes that
# spreads load between them.
H200_DEPLOYMENT_URL=http://host.docker.internal:8003/v1
H200A2_DEPLOYMENT_URL=http://host.docker.internal:8005/v1
H200B_DEPLOYMENT_URL=http://host.docker.internal:8004/v1

# Shared secret for every local idle proxy above — local_deployment (8001), spark
# (8002) and every H200 endpoint (8003/8004/8005). The gateway signs requests with it
# (the `api_keys:` entries on the sglang/vllm routes in the distribution's
# models.yaml) and each proxy checks every inbound request against it, so the two
# ends must carry the same value. The proxies' systemd units read this same file
# so a rotation reaches both at once; boxes with no .env get it from their
# installer instead (LOCAL_API_KEY='…' ./install.sh).
#
# Do NOT leave this blank. Unlike the provider keys above, a blank value here is
# not "feature off" — it is "the proxies and the gateway disagree", which is a
# 100% 401 rate on every local model with nothing in the gateway log naming the
# cause. The value below is the default the proxies fall back to when the
# variable is missing entirely, so it is the one that works out of the box;
# change it on both ends together.
LOCAL_API_KEY=freeinference_api

# --- Observability & Routing Controls ---
# Logging
LOG_FORMAT=json
LOG_LEVEL=DEBUG
LOG_FILE=server.log

# Only trust X-Forwarded-For / X-Real-IP when a trusted proxy overwrites them.
TRUST_PROXY_HEADERS=0

# Additionally trust CF-Connecting-IP, and prefer it over X-Forwarded-For.
# Requires TRUST_PROXY_HEADERS=1. Enable ONLY when Cloudflare is the immediate
# proxy AND the origin rejects traffic that did not come through it
# (Authenticated Origin Pulls or a Cloudflare IP allowlist). Cloudflare always
# overwrites this header, but any other proxy — and any direct-to-origin
# request — forwards a client-supplied value unchanged, making it spoofable.
TRUST_CLOUDFLARE_HEADERS=0

# Provider health & circuit breaker
ROUTER_HEALTH_EWMA_ALPHA=0.1
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_SECONDS=30
CIRCUIT_MIN_AVAILABILITY=0.7

# --- Database ---
# PostgreSQL
# Start with: make up
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hybridinference
DB_USER=
DB_PASSWORD=
DB_ENABLED=true

# Privacy: when false (default), prompt/response payloads are hashed
# rather than stored verbatim in the request log. Set true only if you
# need full content for debugging and have weighed the privacy impact.
DB_STORE_FULL_CONTENT=false

# pgAdmin credentials (optional, only used with: make up COMPOSE_PROFILES=admin).
# Setting COMPOSE_PROFILES here overrides any value a distribution env file
# supplies, so list every profile the host wants, e.g. COMPOSE_PROFILES=admin,oncall.
# A deployment that exposes pgAdmin through the console at /pgadmin/ gates it on
# an admin session there — see docs/developer/deployment.md. SERVER_MODE=True
# keeps pgAdmin's own login on behind that gate, which is why it is set here:
# the Compose fallback is False, and False means no login at all.
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=
PGADMIN_CONFIG_SERVER_MODE=True

# --- Authentication ---
# 0=disabled (all requests allowed), 1=enabled (API key required)
USER_AUTH_ENABLED=1

# For HMAC key hashing - generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEY_SECRET=

# Admin access for /admin/* endpoints
ADMIN_TOKEN=

# Default quotas for new users
SIGNUP_DEFAULT_DAILY_QUOTA_USD=100.00

# JWT Secret Key for authentication - generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# --- Email ---
SMTP_PASSWORD=

# Public URL of the frontend (used in email links: verify, reset, approval).
# Must be absolute and reachable by your users — it is what they click in a
# verification email. The local console listens on 3001.
FRONTEND_URL=http://localhost:3001

# Public URL of this backend API (used as the origin for outgoing links and
# request-base validation). Set it to your own public address once you have
# one; left blank, the backend derives the origin from the incoming request.
BASE_URL=

# --- Cloud agent: this gateway's side of the contract (optional) ---
# The cloud agent runs as a separate service with its own database. It cannot
# authorize anything by itself — it has no user table and no model registry —
# so it asks this gateway, over HTTP, with the two credentials below. Leave
# them unset and this gateway simply does not federate: every identity and
# internal endpoint answers 404, which is the truthful answer and deliberately
# not the 401 a guarded-but-misconfigured deployment would give.
#
# Both must be set before a cutover to a separately deployed cloud agent. The
# agent side documents its half in that repository's ENVIRONMENT.md.

# RSA private key, PEM, unencrypted, 2048 bits or more. This gateway signs
# identity tokens with it and publishes the public half at
# /v1/identity/jwks for the agent to verify against.
#
# **On one line, with literal \n between the PEM's lines.** Compose reads this
# file itself and its parser has no multi-line form: a real PEM pasted across
# several lines fails with `key cannot contain a space`, and the whole stack
# refuses to start — not just this variable. The loader turns the escapes back
# into newlines (`identity_keys._normalize`), which is the same shape the
# GitHub App key uses.
#
# Generate it in that form with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 \
#     | awk '{printf "%s\\n", $0}'
#
# Never commit the value — this file is an example and holds placeholders only.
IDENTITY_JWT_PRIVATE_KEY=

# Public keys to keep publishing in JWKS while a rotation drains. Concatenated
# PEMs; the armour is self-delimiting so several in one value split cleanly.
# During rotation this holds the *old* public key, so tokens signed before the
# swap still verify until they expire.
#
# One line with `\n` escapes, for the same reason as the private key above —
# and this one is set *during* a rotation, when a stack that will not start is
# at its least welcome.
IDENTITY_JWT_RETIRING_PUBLIC_KEYS=

# The `iss` this gateway stamps on identity tokens, and what the agent pins.
# Its own public origin, no trailing slash.
IDENTITY_ISSUER=

# Where an authorization code may be delivered. Comma-separated, and matched
# as an **exact string** — no prefix or wildcard matching, so every callback
# URL is listed in full, including its scheme, port and path. At least one
# value is required for issuance; a deployment with a key but no list publishes
# JWKS and issues nothing.
# For example: https://agent.example.org/auth/callback
IDENTITY_ALLOWED_REDIRECTS=

# Authorizes the cloud agent's control plane to mint and revoke inference
# grants, and to read the model catalog and user status. One shared secret for
# the whole internal API, compared in constant time. A service credential: it
# must never reach a sandbox or a browser, and it is distinct per environment
# so a staging leak cannot mint against production.
# Generate with: openssl rand -hex 32
GATEWAY_GRANT_DISPATCH_TOKEN=

# --- Agent jobs (optional) ---
# Dedicated credential for the runner's /v1/agent/worker/claim calls. Set the
# same value on the gateway (verification) and the runner (presentation).
# Prefer this over handing the runner ADMIN_TOKEN: the runner host executes
# untrusted repository code next door, and this token opens exactly one door.
# Generate with: openssl rand -hex 32
AGENT_DISPATCHER_TOKEN=

# How many agent jobs run at once. One runner takes one job at a time, so this
# is the concurrency limit — with 1, users queue behind each other. Budget one
# sandbox (4g / 2 cpus) per replica.
AGENT_RUNNER_REPLICAS=3

# --- Agent egress (optional; the compose overlay ships working defaults) ---
# Egress is a per-phase tier. `setup` installs dependencies and reaches package
# registries through an allowlist proxy; `agent` — the turn driven by untrusted
# model output — reaches the gateway and nothing else. Raising the agent phase
# is the one change here with a real security cost, so it is left explicit.
#
# Tiers: platform_only (gateway only) | trusted (allowlist proxy) |
#        custom (your own network/proxy) | full (unrestricted; must be
#        acknowledged with AGENT_SANDBOX_ALLOW_OPEN_NETWORK=1)
AGENT_EGRESS_SETUP_TIER=trusted
AGENT_EGRESS_AGENT_TIER=platform_only

# Added to the built-in registry list (PyPI, npm, crates, Go, RubyGems, Maven,
# github.com), never a replacement for it. Comma-separated; `*.example.com`
# means the domain and its subdomains. An agent vendor's telemetry domain is
# refused outright — a sandbox that can phone home about a private repository
# is not closed, whatever the tier is called.
AGENT_EGRESS_ALLOWLIST=

# Only if you run the proxy somewhere other than the compose overlay's own
# service. Both must change together: the network is internal, so a proxy URL
# pointing off it is unreachable rather than merely wrong.
AGENT_EGRESS_NETWORK_TRUSTED=agent-egress-trusted
AGENT_EGRESS_PROXY_URL_TRUSTED=http://agent-egress-proxy:3128

# --- Agent source-control integrations (optional) ---
# GitHub uses a GitHub App. The authorization URL must be on github.com; set
# the App callback URL to <frontend>/agents/connected?provider=github.
AGENT_GITHUB_APP_ID=
AGENT_GITHUB_APP_PRIVATE_KEY_PATH=
AGENT_GITHUB_APP_CLIENT_ID=
AGENT_GITHUB_APP_CLIENT_SECRET=
# App installation URL, for example:
# https://github.com/apps/<app-slug>/installations/new
# Connect/Reauthorize is derived separately from AGENT_GITHUB_APP_CLIENT_ID.
AGENT_GITHUB_APP_INSTALL_URL=

# GitLab.com OAuth is read-only project discovery in this release.
# Register the exact callback below in the GitLab OAuth application and grant
# read_user + read_api. Tokens are encrypted with a key derived from
# API_KEY_SECRET before they are stored.
AGENT_GITLAB_OAUTH_CLIENT_ID=
AGENT_GITLAB_OAUTH_CLIENT_SECRET=
AGENT_GITLAB_OAUTH_REDIRECT_URI=http://localhost:3001/agents/connected?provider=gitlab

# --- Vector DB ---
QDRANT_API_KEY=

# --- LLM Prober (optional) ---
# API key used by gateway probes issued from the llm-prober service.
PROBER_API_KEY=

# --- Slack alerting (optional) ---
# Slack alerting (optional). Empty SLACK_WEBHOOK_URL disables alerts.
SLACK_WEBHOOK_URL=
FAILED_REQUEST_ALERT_THRESHOLD=200
FAILED_REQUEST_ALERT_WINDOW_MINUTES=5
FAILED_REQUEST_ALERT_COOLDOWN_MINUTES=5

# --- Alerting framework ---
# Master kill-switch. Phase 1 ships dark — keep this false until staging soak.
ALERTS_ENABLED=false
# Webhook for the in-process alerting framework. If unset, falls back to
# SLACK_WEBHOOK_URL above so a single webhook works for both code paths.
SLACK_ALERTS_WEBHOOK_URL=
# Path to the alert rules / thresholds YAML.
# Alert rules belong to a deployment; upstream ships none, and without a file
# here the built-in thresholds apply. Point this at your own.
# ALERTS_CONFIG_PATH=            # unset uses the built-in thresholds

# --- Config file paths ---
# Model registry and routing config locations, resolved relative to the working
# directory. The legacy MODELS_CONFIG / ROUTING_CONFIG names are still honored;
# the canonical *_CONFIG_PATH name wins when both are set.
# MODELS_CONFIG_PATH=config/examples/models.openrouter.yaml
# ROUTING_CONFIG_PATH=config/examples/routing.minimal.yaml
# Optional distribution manifest (see config/examples/distribution.example.yaml).
# Explicit *_CONFIG_PATH vars above win over the manifest's paths section.
# Mode defaults to "dark": the manifest loads/validates and logs what would
# change while current resolution stays effective. First enablement MUST run
# dark; applying manifest paths requires an explicit
# DISTRIBUTION_CONFIG_MODE=active after the dark comparisons check out.
# DISTRIBUTION_CONFIG_PATH=distributions/<name>/distribution.yaml
# DISTRIBUTION_CONFIG_MODE=dark

# --- Codex On-Call alert analysis (optional) ---
# When both values are set, alert producers send structured events to the relay
# first and fall back to the Slack webhook above if the relay is unavailable.
# The relay posts the original alert to Slack and hands analysis to the
# codex-oncall GitHub Actions workflow. Enable the Compose service with
# COMPOSE_PROFILES=oncall after creating the separate mode-0600 .env.oncall
# file from .env.oncall.example; relay-only credentials (Slack bot, GitHub
# dispatch token, model settings) belong there, not in this backend
# environment. The workflow's own secrets (CODEX_ONCALL_MODEL_API_KEY,
# CODEX_ONCALL_SLACK_BOT_TOKEN) are configured as GitHub Actions secrets.
# COMPOSE_PROFILES=oncall
CODEX_ONCALL_RELAY_URL=
CODEX_ONCALL_RELAY_TOKEN=
