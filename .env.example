# ============================================================
# hybridInference Environment Variables
# ============================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# Required for `make up` (Docker Compose):
#   DB_NAME, DB_USER, DB_PASSWORD, JWT_SECRET_KEY, API_KEY_SECRET
#
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================================

# --- LLM Provider API Keys ---
LLAMA_API_KEY=
LLAMA_BASE_URL=https://api.llama.com/compat/v1
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
ZAI_API_KEY=

# External Providers
CHUTES_BASE_URL=https://llm.chutes.ai
CHUTES_API_KEY=

FEATHERLESS_BASE_URL=https://api.featherless.ai
FEATHERLESS_API_KEY=

MINIMAX_API_KEY=
MINIMAX_SESSION_COOKIE=
MINIMAX_GROUP_ID=

# OpenRouter (https://openrouter.ai) — used when models route through
# `kind: openrouter` or `kind: openrouter[<provider_slug>]`.
OPENROUTER_API_KEY=

# Local VLLM server (freeinference.org or your own deployment)
LOCAL_BASE_URL=http://freeinference.org/v1
OFFLOAD=1

# --- Observability & Routing Controls ---
# Logging
LOG_FORMAT=json
LOG_LEVEL=DEBUG
LOG_FILE=server.log

# Label normalization for structured logs (full|family)
METRICS_MODEL_LABEL=family

# Only trust X-Forwarded-For / X-Real-IP when a trusted proxy overwrites them.
TRUST_PROXY_HEADERS=0

# Provider health & circuit breaker
ROUTER_HEALTH_EWMA_ALPHA=0.2
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_SECONDS=30
CIRCUIT_MIN_AVAILABILITY=0.7

# --- Database ---
# Backend selection: "postgres" (default) or "d1" (Cloudflare D1)
DB_BACKEND=postgres

# PostgreSQL (used when DB_BACKEND=postgres)
# Start with: make up
DB_HOST=localhost
DB_PORT=5432
DB_NAME=freeinference_db
DB_USER=
DB_PASSWORD=
DB_ENABLED=true

# Privacy: when false (default), prompt/response payloads are hashed
# rather than stored verbatim in the request log. Set true only if you
# need full content for debugging and have weighed the privacy impact.
DB_STORE_FULL_CONTENT=false

# Cloudflare D1 (required when DB_BACKEND=d1)
# Account ID and Database ID from: Cloudflare Dashboard → Workers & Pages → D1
D1_ACCOUNT_ID=
D1_DATABASE_ID=
# API token with D1:Edit permission: Cloudflare Dashboard → My Profile → API Tokens
D1_API_TOKEN=

# Cloudflare R2 – log archival (used by scripts/cloudflare/r2_archive_logs.py)
# Create credentials: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=hybridinference-logs
R2_LOG_RETENTION_DAYS=30

# pgAdmin credentials (optional, only used with: make up COMPOSE_PROFILES=admin)
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=
PGADMIN_CONFIG_SERVER_MODE=True

# --- Authentication ---
# 0=disabled (all requests allowed), 1=enabled (API key required)
USER_AUTH_ENABLED=1

# For HMAC key hashing - generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEY_SECRET=

# Admin access for /admin/* endpoints
ADMIN_TOKEN=

# Default quotas for new users
SIGNUP_DEFAULT_DAILY_QUOTA_USD=100.00

# JWT Secret Key for authentication - generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# --- Email ---
SMTP_PASSWORD=

# Public URL of the frontend (used in email links: verify, reset, approval).
# Override per environment — e.g. for staging:
#   FRONTEND_URL=https://staging.freeinference.org
FRONTEND_URL=https://freeinference.org

# Public URL of this backend API (used as the origin for outgoing links and
# request-base validation). Override per environment.
BASE_URL=https://freeinference.org

# --- Vector DB ---
QDRANT_API_KEY=

# --- LLM Prober (optional) ---
# API key used by gateway probes issued from the llm-prober service.
PROBER_API_KEY=

# --- Slack alerting (optional) ---
# Slack alerting (optional). Empty SLACK_WEBHOOK_URL disables alerts.
SLACK_WEBHOOK_URL=
FAILED_REQUEST_ALERT_THRESHOLD=20
FAILED_REQUEST_ALERT_WINDOW_MINUTES=5
FAILED_REQUEST_ALERT_COOLDOWN_MINUTES=5
