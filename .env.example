# ============================================================
# hybridInference Environment Variables
# ============================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# Required for `make up` (Docker Compose):
#   DB_NAME, DB_USER, DB_PASSWORD, JWT_SECRET_KEY, API_KEY_SECRET
#
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================================

# --- LLM Provider API Keys ---
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
ZAI_API_KEY=

# External Providers
CHUTES_BASE_URL=https://llm.chutes.ai
CHUTES_API_KEY=

FEATHERLESS_BASE_URL=https://api.featherless.ai
FEATHERLESS_API_KEY=

MINIMAX_API_KEY=

# Local VLLM server (freeinference.org or your own deployment)
LOCAL_BASE_URL=http://freeinference.org/v1
OFFLOAD=1

# --- Observability & Routing Controls ---
# Logging
LOG_FORMAT=json
LOG_LEVEL=DEBUG
LOG_FILE=server.log

# Metrics
METRICS_ENABLED=1
METRICS_MODEL_LABEL=family

# Trust X-Forwarded-For / X-Real-IP when using the bundled Nginx reverse proxy.
TRUST_PROXY_HEADERS=1

# Fair Serving waiting requests
FAIRNESS_ENABLED=0

# Provider health & circuit breaker
ROUTER_HEALTH_EWMA_ALPHA=0.2
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_SECONDS=30
CIRCUIT_MIN_AVAILABILITY=0.7

# --- Database (PostgreSQL) ---
# Start with: make up
DB_HOST=localhost
DB_PORT=5432
DB_NAME=freeinference_db
DB_USER=
DB_PASSWORD=
DB_ENABLED=true

# pgAdmin credentials (optional, only used with: make up COMPOSE_PROFILES=admin)
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=
PGADMIN_CONFIG_SERVER_MODE=True

# --- Authentication ---
# 0=disabled (all requests allowed), 1=enabled (API key required)
USER_AUTH_ENABLED=1

# --- Frontend deployment target ---
# Production build talks to https://freeinference.org by default.
# Staging build talks to http://localhost:8000 by default, which is convenient
# when you forward staging ports back to your laptop.
NEXT_PUBLIC_DEPLOY_TARGET=production
# Optional explicit override for the frontend API base. This value is baked into
# the Next.js bundle at build time, so rebuilding the frontend is required after
# changing it.
NEXT_PUBLIC_API_BASE=https://freeinference.org
# Staging backend port published by docker-compose.staging.yml
BACKEND_PORT=8000
# Staging-only frontend port used by infrastructure/docker/docker-compose.staging.yml
FRONTEND_PORT=3002
# Optional backend CORS override for SSH-forwarded local origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,https://freeinference.org

# For HMAC key hashing - generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEY_SECRET=

# Admin access for /admin/* endpoints
ADMIN_TOKEN=

# Default quotas for new users
USER_DEFAULT_DAILY_COST_USD=1000.00
USER_DEFAULT_MONTHLY_COST_USD=

# Token limitations
GLM_TPH_LIMIT=10000000

# JWT Secret Key for authentication - generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_REFRESH_TOKEN_EXPIRE_DAYS=365

# --- Email ---
SMTP_PASSWORD=

# --- Vector DB ---
QDRANT_API_KEY=

# --- Grafana (optional) ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# --- LLM Prober (optional) ---
# API key used by gateway probes issued from the llm-prober service.
PROBER_API_KEY=
