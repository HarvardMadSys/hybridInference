# ============================================================
# hybridInference environment
# ============================================================
# Copy this file to .env and fill in the database login:
#   cp .env.example .env
#
# Required for `make up` (Docker Compose): DB_NAME, DB_USER, DB_PASSWORD.
#
# Application settings are not kept here. Provider API keys, SMTP, Slack,
# proxy trust, routing tuning and the sign-in and API-key secrets live in the
# database, and you edit them in the admin console under
# Admin > Configuration; the runtime switches, such as USER_AUTH_ENABLED and
# SIGNUP_ENABLED, are on the Settings tab beside it. On a new database the
# backend generates JWT_SECRET_KEY and API_KEY_SECRET itself and logs a
# one-time setup code: open the console, enter the code, and create the
# administrator.
#
# Upgrading from a release that kept those settings here: your .env keeps
# working. At startup, every setting that has a value here and none in the
# database yet is copied into the database. From then on the database value
# wins and the line here is ignored, so you can delete it once the new release
# has started -- keep a copy while you might roll back, because older releases
# read it only from here. A multi-line value such as the
# IDENTITY_JWT_PRIVATE_KEY PEM must stay on one line in this file, with a
# literal \n between the PEM's lines: Compose's parser has no multi-line form,
# and one value spread over several lines stops the whole stack from
# starting. Admin > Configuration takes the PEM as it is.
#
# What remains is what the backend needs before it can reach the database,
# and what describes the containers rather than the application.
# ============================================================

# --- Database ---
# PostgreSQL. Compose refuses to start until DB_NAME, DB_USER and DB_PASSWORD
# have values. DB_HOST matters only to a backend started from a source
# checkout: under Compose the backend always reaches the `postgres` service,
# and DB_PORT is the host side of its published port.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hybridinference
DB_USER=
DB_PASSWORD=
DB_ENABLED=true

# The database holds every provider key, the SMTP password and the signing
# secrets in plaintext. Protect its backups, and psql or pgAdmin access to it,
# the way you would protect a .env that held them.

# --- Docker Compose host access ---
# Backend and frontend ports default to loopback on the Docker host. For direct
# access from other machines, explicitly bind the required service to a host IP or
# 0.0.0.0 and configure your reverse proxy/firewall. Container listeners stay
# unchanged; these settings only control the published host ports.
# BACKEND_HOST=127.0.0.1
# FRONTEND_HOST=127.0.0.1
# BACKEND_PORT=8080
# FRONTEND_PORT=3001

# --- pgAdmin (optional) ---
# Only used with: make up COMPOSE_PROFILES=admin.
# Setting COMPOSE_PROFILES here overrides any value a distribution env file
# supplies, so list every profile the host wants, e.g. COMPOSE_PROFILES=admin.
# A deployment that exposes pgAdmin through the console at /pgadmin/ gates it on
# an admin session there — see docs/developer/deployment.md. SERVER_MODE=True
# keeps pgAdmin's own login on behind that gate, which is why it is set here:
# the Compose fallback is False, and False means no login at all.
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=
PGADMIN_CONFIG_SERVER_MODE=True

# --- Backend process ---
# Also write the backend's log to this file, relative to its working directory.
LOG_FILE=server.log

# Trusted Python modules the backend imports at startup, comma-separated; see
# docs/developer/backend-extensions.md.
# BACKEND_EXTENSIONS=

# Country database for request analytics. The Compose file sets both for the
# container; a backend started from a source checkout reads them from here.
# GEOIP_COUNTRY_DB=var/data/geoip/dbip-country-lite.mmdb
# GEOIP_COUNTRY_PROVIDER=dbip-lite

# Name of the sign-in refresh cookie. The backend and the console must agree,
# and Compose passes this one value to both.
# REFRESH_TOKEN_COOKIE_NAME=refresh_token

# --- Console ---
# Build-time origin used by every console-to-backend route, including the
# server-side /site-config request. Canonical prebuilt consoles fix this to the
# backend service on the private application network; changing it requires a
# source rebuild, not a container-only environment override.
BACKEND_INTERNAL_URL=http://backend:8080

# Absolute path inside the frontend container to a dedicated public branding
# image directory. Mount it read-only in the deployment overlay. Unset disables
# /site-assets; only common image formats are served from a configured path.
SITE_ASSETS_DIR=

# --- Cloud agent (optional) ---
# The cloud agent runs as a separate service with its own repository and
# database. On a host that also runs it, the console proxies /agents to the
# two internal URLs below, read at request time, and the deploy scripts use the
# network name to decide whether to attach the console to that stack. A
# deployment that runs no cloud agent leaves all three unset and /agents
# answers 404.
AGENT_WEB_INTERNAL_URL=
AGENT_CONTROL_PLANE_INTERNAL_URL=
AGENT_NETWORK_NAME=

# When the agent lives on its own hostname, show its dashboard entry point
# without enabling the /agents proxy. A public HTTPS URL, without credentials,
# read at console runtime; leave empty to use /agents when both proxy targets
# above are configured. This URL is sent to the browser.
AGENT_PUBLIC_URL=

# This gateway's half of the contract with the agent -- the IDENTITY_*
# settings and GATEWAY_GRANT_DISPATCH_TOKEN -- is in Admin > Configuration,
# under Integrations. Any other AGENT_* variable an older .env still carries
# configured the agent while it ran inside this gateway; nothing here reads
# it. Carry those across to the machine that runs the agent's control plane,
# as that repository's ENVIRONMENT.md describes, rather than concluding the
# feature was withdrawn.

# --- Config file paths ---
# Model registry and routing config locations, resolved relative to the working
# directory. The legacy MODELS_CONFIG / ROUTING_CONFIG names are still honored;
# the canonical *_CONFIG_PATH name wins when both are set.
# MODELS_CONFIG_PATH=config/examples/models.openrouter.yaml
# ROUTING_CONFIG_PATH=config/examples/routing.minimal.yaml
# Alert rules belong to a deployment; upstream ships none, and without a file
# here the built-in thresholds apply. Point this at your own.
# ALERTS_CONFIG_PATH=            # unset uses the built-in thresholds
# Optional manifest-only reference (see config/examples/distribution.example.yaml).
# For the no-secret runnable router bundle, use `make up DISTRIBUTION=example`;
# its complete inputs live under distributions/example/.
# Explicit *_CONFIG_PATH vars above win over the manifest's paths section.
# Mode defaults to "dark": the manifest loads/validates and logs what would
# change while current resolution stays effective. First enablement MUST run
# dark; applying manifest paths requires an explicit
# DISTRIBUTION_CONFIG_MODE=active after the dark comparisons check out.
# DISTRIBUTION_CONFIG_PATH=distributions/<name>/distribution.yaml
# DISTRIBUTION_CONFIG_MODE=dark
