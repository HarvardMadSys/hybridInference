# Secrets and runtime settings for the Docker Compose codex-triage relay.
# Copy this file to .env.triage, chmod it 0600, and never commit the populated file.

CODEX_TRIAGE_RELAY_TOKEN=replace-with-a-random-shared-token
CODEX_TRIAGE_SLACK_BOT_TOKEN=xoxb-replace-me
CODEX_TRIAGE_SLACK_CHANNEL_ID=C0123456789

# Fine-grained GitHub token that may send repository_dispatch to the repo
# below (Contents: read & write on that single repository is sufficient).
CODEX_TRIAGE_GITHUB_TOKEN=github_pat_replace-me
CODEX_TRIAGE_GITHUB_REPOSITORY=HarvardMadSys/hybridInference

# Passed through in the dispatch payload; the GitHub Actions workflow uses
# these to call the gateway's Responses API. The base URL must be reachable
# from GitHub-hosted runners, so use the public gateway address.
CODEX_TRIAGE_CODEX_MODEL=deepseek-v4-flash
CODEX_TRIAGE_HYBRID_BASE_URL=https://freeinference.org/v1

# Optional worker tuning.
CODEX_TRIAGE_POLL_SECONDS=1
CODEX_TRIAGE_MAX_ATTEMPTS=2
CODEX_TRIAGE_MAX_PENDING_JOBS=100
