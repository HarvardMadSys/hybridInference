.git
.venv
__pycache__
*.pyc

# Local dotenv files are neither deterministic build inputs nor safe context.
# In particular, Next automatically loads nested apps/frontend/.env*. The
# checked-in deployment files are named backend.env/frontend.env and remain
# available to Compose; only dot-env files are excluded here.
.env
.env.*
**/.env
**/.env.*

# Frontend build artifacts
apps/frontend/node_modules
apps/frontend/.next
apps/frontend/.site-ui-build-env
apps/frontend/src/site-ui/external
apps/frontend/src/site-ui/active
apps/frontend/src/generated
apps/frontend/tsconfig.generated.json

# Data & logs (never bake into images)
var/

# Host-local lifecycle state: .ops.env, and each deployment's pinned images,
# release history and default database dumps under .ops/. A dump holds every
# stored secret, wherever an operator writes it.
.ops*
*.dump
**/*.dump

# Dev/test
tests/
docs/

# IDE
.vscode/
.idea/
*.swp
