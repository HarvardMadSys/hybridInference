# --- Language-code guesses ---------------------------------------------
/zh                                    /zh_CN/                           301
/zh/*                                  /zh_CN/:splat                     301
/zh-cn                                 /zh_CN/                           301
/zh-cn/*                               /zh_CN/:splat                     301
/zh-CN                                 /zh_CN/                           301
/zh-CN/*                               /zh_CN/:splat                     301
