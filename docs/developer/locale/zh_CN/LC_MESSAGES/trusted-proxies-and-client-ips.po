msgid "IP-related keys stored"
msgstr "存下的 IP 相关字段"

#: ../developer/trusted-proxies-and-client-ips.md
msgid "`/v1/chat/completions`"
msgstr ""

#: ../developer/trusted-proxies-and-client-ips.md
msgid "`apps/backend/serving/servers/routers/completions.py`"
msgstr ""

