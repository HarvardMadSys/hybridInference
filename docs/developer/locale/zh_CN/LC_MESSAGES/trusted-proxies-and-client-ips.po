#: ../developer/trusted-proxies-and-client-ips.md
msgid "`apps/backend/serving/servers/routers/anthropic_messages.py`"
msgstr ""

#: ../developer/trusted-proxies-and-client-ips.md
msgid ""
"`ip`, `peer_ip`, `ip_source`, `x_forwarded_for`, `x_real_ip`, "
"`user_agent`, `referer`"
msgstr ""

#: ../developer/trusted-proxies-and-client-ips.md
msgid "Rejected requests (when rejection logging is enabled)"
msgstr "被拒绝的请求（在开启拒绝日志时）"

#: ../developer/trusted-proxies-and-client-ips.md
msgid "`apps/backend/serving/observability/rejection_log.py`"
msgstr ""

