msgid "API key; changing a webhook needs `BATCH_MIN_ROLE`"
msgstr "API key；修改 webhook 需要 `BATCH_MIN_ROLE`"

#: ../developer/architecture.md
msgid "Model catalog"
msgstr "模型目录"

#: ../developer/architecture.md
