"`GET /v1/usage`, `GET /v1/dashboard/billing/subscription`, `GET "
"/v1/dashboard/billing/usage`, `GET /v1/dashboard/billing/credit_grants`, "
"`GET /v1/sub2api/billing`, `GET /anthropic/user/balance`"
msgstr ""
"`GET /v1/usage`, `GET /v1/dashboard/billing/subscription`, `GET "
"/v1/dashboard/billing/usage`, `GET /v1/dashboard/billing/credit_grants`, "
"`GET /v1/sub2api/billing`, `GET /anthropic/user/balance`"

#: ../developer/architecture.md
msgid "API key; answers even when the quota is spent"
msgstr "API key；配额用完时仍会响应"

#: ../developer/architecture.md
msgid "API key description"
msgstr "API 密钥说明"

