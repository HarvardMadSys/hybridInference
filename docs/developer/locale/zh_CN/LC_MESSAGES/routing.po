#~ msgstr ""
#~ "`TreeBackend` 接受处于其模型和 endpoint 范围内的 binding。子"
#~ " router 对该目标做准入检查，再通过叶子执行；不得重新选择或 fallback 到其他"
#~ " endpoint。"

#~ msgid "`DelegatePool(pool_id)`"
#~ msgstr "`DelegatePool(pool_id)`"

#~ msgid "Select inside the named pool."
#~ msgstr "在指定池内选择。"

#~ msgid ""
#~ "`TreeBackend` delegates selection, admission, "
#~ "retries, and hedging to its scoped "
#~ "router."
#~ msgstr "`TreeBackend` 将选择、准入、重试和 hedging 委托给其范围受限的 router。"

#~ msgid ""
#~ "An exact dispatch can therefore pass "
#~ "through a child router for admission;"
#~ " the instruction limits that router "
#~ "to the bound endpoint. `check_dispatch()` "
#~ "and the pool's request validation reject"
