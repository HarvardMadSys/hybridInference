msgid "Approach"
msgstr "方案"

#: ../developer/distribution-customization.md
msgid "What you maintain"
msgstr "你需要维护什么"

#: ../developer/distribution-customization.md
msgid "What upstream provides"
msgstr "上游提供什么"

