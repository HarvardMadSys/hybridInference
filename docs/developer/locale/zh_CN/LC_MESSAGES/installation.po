msgid "Effect"
msgstr "作用"

#: ../developer/installation.md
msgid "`USER_AUTH_ENABLED`"
msgstr ""

#: ../developer/installation.md
msgid "`1` (default) requires an API key on `/v1/*`; `0` allows every request"
msgstr "`1`（默认）要求 `/v1/*` 带 API key；`0` 放行所有请求"

#: ../developer/installation.md
msgid "`ADMIN_TOKEN`"
msgstr ""

#: ../developer/installation.md
msgid "bearer token for the `/admin/*` endpoints"
msgstr "`/admin/*` 端点使用的 bearer token"

#: ../developer/installation.md
msgid "`DB_ENABLED`"
msgstr ""

#: ../developer/installation.md
msgid "`false` runs the gateway with no database"
msgstr "`false` 让网关不带数据库运行"

#: ../developer/installation.md
msgid "`DB_STORE_FULL_CONTENT`"
msgstr ""

#: ../developer/installation.md
msgid "`false` (default) hashes prompts and responses instead of storing them"
msgstr "`false`（默认）对 prompt 和响应做哈希，而不是把原文存下来"

#: ../developer/installation.md
msgid "`FRONTEND_URL`"
msgstr ""

#: ../developer/installation.md
msgid "absolute URL your users click in verification and reset emails"
