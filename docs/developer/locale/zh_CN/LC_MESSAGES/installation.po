#: ../developer/installation.md
msgid "`BASE_URL`"
msgstr ""

#: ../developer/installation.md
msgid "this gateway's own public origin; blank derives it from the request"
msgstr "本网关自己的公网 origin；留空则从请求中推导"

#: ../developer/installation.md
msgid "`LOG_LEVEL`, `LOG_FORMAT`"
msgstr ""

#: ../developer/installation.md
