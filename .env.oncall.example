# Secrets and runtime settings for the Docker Compose codex-oncall relay.
# Copy this file to .env.oncall, chmod it 0600, and never commit the populated file.

CODEX_ONCALL_RELAY_TOKEN=replace-with-a-random-shared-token
CODEX_ONCALL_SLACK_BOT_TOKEN=xoxb-replace-me
CODEX_ONCALL_SLACK_CHANNEL_ID=C0123456789

# Fine-grained GitHub token that may send repository_dispatch to the repo
# below (Contents: read & write on that single repository is sufficient).
CODEX_ONCALL_GITHUB_TOKEN=github_pat_replace-me
CODEX_ONCALL_GITHUB_REPOSITORY=<owner>/<repo>

# Passed through in the dispatch payload; the GitHub Actions workflow uses
# these to call the analysis model. Codex is Responses-API-only (chat wire
# support was removed upstream, openai/codex#7782), so the base URL must
# serve /v1/responses — in practice this gateway, which must be reachable from
# GitHub-hosted runners (public address, not a Compose hostname). The matching
# hyi- key lives in the CODEX_ONCALL_MODEL_API_KEY GitHub Actions secret,
# not here.
# A model your gateway actually serves. The reference registry shipped in
# config/examples/ registers llama-3.3-70b; a deployment with its own catalogue
# names one of its own. Codex is Responses-API-only, so it has to be a model
# the gateway can serve /v1/responses for.
CODEX_ONCALL_CODEX_MODEL=llama-3.3-70b
CODEX_ONCALL_MODEL_BASE_URL=https://your-gateway.example/v1

# Optional worker tuning.
CODEX_ONCALL_POLL_SECONDS=1
CODEX_ONCALL_MAX_ATTEMPTS=2
CODEX_ONCALL_MAX_PENDING_JOBS=100

# ── Cloud-agent backend (optional) ────────────────────────────────────
# Which platform runs the analysis: "github" (the Actions workflow above) or
# "cloud-agent" (a job on the FreeInference cloud agent platform — no Actions
# minutes, a per-attempt inference grant instead of a long-lived key, spend
# attributed in api_logs.agent_job_id). With "cloud-agent" the GITHUB_* and
# MODEL_BASE_URL values above are unused; the AGENT_* pair below is required
# and the control plane must be configured with the matching
# AGENT_ONCALL_DISPATCH_TOKEN / AGENT_ONCALL_USER_ID (see
# docs/developer/codex-oncall.md).
CODEX_ONCALL_DISPATCH_BACKEND=github
#CODEX_ONCALL_AGENT_BASE_URL=https://your-agent-control-plane.example
#CODEX_ONCALL_AGENT_DISPATCH_TOKEN=replace-with-the-control-plane-oncall-token
# Repository the analysis checks out; defaults to CODEX_ONCALL_GITHUB_REPOSITORY.
#CODEX_ONCALL_AGENT_REPO=<owner>/<repo>
# Branch pinned to a commit at job creation.
#CODEX_ONCALL_AGENT_BASE_REF=dev
#CODEX_ONCALL_AGENT_RUNTIME=codex
# Poll cadence and how long to wait before cancelling a stuck analysis.
#CODEX_ONCALL_AGENT_POLL_SECONDS=10
#CODEX_ONCALL_AGENT_TIMEOUT_SECONDS=1500
# Where a human reads the job; {job_id} is substituted.
#CODEX_ONCALL_AGENT_CONSOLE_URL=https://your-agent-web.example/agents/jobs/{job_id}
