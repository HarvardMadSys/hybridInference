# Checked-in local defaults only. Override the three EXAMPLE_UPSTREAM_* values
# in the shell to route the same model config to a real OpenAI-compatible API.
#
BACKEND_ENV_FILE=../../distributions/example/deploy/backend.env
# Deliberately not 8080: a machine that already runs a gateway publishes that
# port, and the tutorial's first command must not fail on the very people most
# likely to run it.
BACKEND_PORT=18080
DISTRIBUTION_CONFIG_PATH=/app/distributions/example/distribution.yaml
DISTRIBUTION_CONFIG_MODE=active

EXAMPLE_UPSTREAM_BASE_URL=http://example-provider:8351
EXAMPLE_UPSTREAM_API_KEY=example-local-key
EXAMPLE_UPSTREAM_MODEL=example-upstream

# Compose validates the production Postgres service even though the example's
# backend-only `make up` does not start it. These inert local values satisfy
# that validation; DB_ENABLED remains false inside the backend container.
DB_NAME=hybridinference_example
DB_USER=example
DB_PASSWORD=example-local-only

SITE_NAME=Example Router
SITE_PUBLIC_BASE_URL=http://localhost:18080
SITE_SUPPORT_EMAIL=support@example.test
