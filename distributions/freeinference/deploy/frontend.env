# FreeInference's console identity.
#
# Upstream ships an unbranded console; these are the build-time values that
# make it this site. Read by `docker compose --env-file` (see ops/deploy/*.sh)
# ahead of the server's `.env`, so per-host overrides still win.
#
# These are all NEXT_PUBLIC_* — they are compiled into the browser bundle and
# are public by definition. Never put a secret here.

NEXT_PUBLIC_API_BASE=https://freeinference.org
NEXT_PUBLIC_APP_NAME=FreeInference
NEXT_PUBLIC_APP_DESCRIPTION=Free LLM inference for research, built at Harvard SEAS.
NEXT_PUBLIC_SITE_HOST=freeinference.org

NEXT_PUBLIC_ORG_NAME=Harvard SEAS
NEXT_PUBLIC_ORG_URL=https://madsys.seas.harvard.edu
NEXT_PUBLIC_ORG_TAGLINE=Built at Harvard SEAS · MadSys Lab
NEXT_PUBLIC_DOCS_URL=https://doc.freeinference.org/
NEXT_PUBLIC_STATUS_URL=https://status.staging.freeinference.org/
NEXT_PUBLIC_CONTACT_EMAIL=admin@freeinference.org

NEXT_PUBLIC_EXAMPLE_API_BASE=https://freeinference.org
NEXT_PUBLIC_EXAMPLE_API_KEY_ENV_VAR=FREEINFERENCE_API_KEY
NEXT_PUBLIC_EXAMPLE_MODEL=glm-5.1

NEXT_PUBLIC_STATCOUNTER_PROJECT_ID=13224568
NEXT_PUBLIC_STATCOUNTER_SECURITY_KEY=2d8ab84a

NEXT_PUBLIC_FAST_TRACK_DOMAIN=harvard.edu
NEXT_PUBLIC_FAST_TRACK_ORG=Harvard

# Prefixes this site's browser-local storage keys. Changing it signs everyone
# out of their locally cached console state, so it is pinned rather than
# derived from the app name.
NEXT_PUBLIC_STORAGE_KEY_PREFIX=freeinference

# Remote host allowed for team photos (see apps/frontend/next.config.js).
NEXT_PUBLIC_TEAM_IMAGE_HOST=junchengyang.com

# What this site tells users it does with their prompts. Every deployment
# answers this differently, so upstream asserts nothing and the console shows
# the notice only when one is set.
NEXT_PUBLIC_DATA_POLICY_NOTICE=All prompts and responses are logged for research purposes. Anonymized data derived from requests may be open-sourced to support research.

# The people and sponsors shown on the landing page.
NEXT_PUBLIC_TEAM_JSON=[{"name":"Juncheng Yang","affiliations":["Assistant Professor at Harvard University"],"badge":"Lead","image":"https://junchengyang.com/img/me4.jpg"},{"name":"Murphy Tian","affiliations":["Research Intern at Harvard University","Undergraduate at University of Toronto"],"badge":"Core developer","image":"/team/murphy-tian.jpg","website":"https://realtmxi.github.io/"},{"name":"Haoran Ni","affiliations":["Research Intern at Harvard University","Undergraduate at NJU"]}]
NEXT_PUBLIC_SPONSORS_JSON=[{"name":"NVIDIA","alt":"NVIDIA logo","src":"/sponsors/nvidia.svg","className":"h-10 sm:h-12","width":975,"height":180},{"name":"Harvard SEAS","alt":"Harvard SEAS logo","src":"/sponsors/harvard-seas.svg","className":"h-12 sm:h-14","width":307,"height":86}]
