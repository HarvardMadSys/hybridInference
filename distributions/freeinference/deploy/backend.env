# FreeInference's backend identity.
#
# Upstream ships neutral defaults so a clone does not rebrand itself as this
# site; the values that make the deployment *this* site live here, in the
# distribution overlay, and the deploy scripts feed this file to
# `docker compose --env-file` ahead of the server's `.env`. Anything the
# server's `.env` sets still wins, so per-host overrides keep working.
#
# Secrets never belong in this file — it is checked in. Keys, passwords and
# tokens stay in the server's `.env`.

SITE_NAME=FreeInference
SITE_PUBLIC_BASE_URL=https://freeinference.org
SITE_DOCS_URL=https://doc.freeinference.org
SITE_SUPPORT_EMAIL=admin@freeinference.org

SMTP_FROM_EMAIL=noreply@freeinference.org
SMTP_FROM_NAME=FreeInference

BASE_URL=https://freeinference.org
FRONTEND_URL=https://freeinference.org

# Local development origins come first so they match the upstream default,
# then the site's own origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002,https://localhost:8443,https://127.0.0.1:8443,http://freeinference.org,http://freeinference.org:3001,https://freeinference.org,https://freeinference.org:3001,http://staging-internal.freeinference.org,https://staging-internal.freeinference.org

# Alert rules. `distributions/` is bind-mounted read-only under /app in the
# container (deploy/docker/docker-compose.yml), so this is a container path.
ALERTS_CONFIG_PATH=/app/distributions/freeinference/config/alerts.yaml
ROUTING_CONFIG_PATH=/app/distributions/freeinference/config/routing.yaml
