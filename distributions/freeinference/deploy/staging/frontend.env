# Staging-only frontend overrides. This file is loaded after the shared
# distribution env files by ops/deploy/deploy_staging.sh.
#
# Every value here answers one question: what would staging otherwise claim
# about itself that is only true of production? The shared layer is written for
# the public site, so anything in it naming a production host arrives on staging
# as a confident lie. test_staging_overlay_answers_for_every_production_host
# enumerates them, so a new one cannot be added to the shared layer and
# forgotten here.

NEXT_PUBLIC_API_BASE=https://staging.freeinference.org
NEXT_PUBLIC_SITE_HOST=staging.freeinference.org
NEXT_PUBLIC_DOCS_URL=https://doc.staging.freeinference.org/

# staging's own status host, not production's. This hostname served the page
# until the monitor was split in two, when it followed the production instance
# and the staging half was left without one; the shared layer then supplied
# production's to both, so anyone checking staging's health read a page where
# every model is green because it is a different deployment.
NEXT_PUBLIC_STATUS_URL=https://status.staging.freeinference.org/

# The landing page's copy-pasteable curl. Inherited, it handed a staging
# visitor a command that runs against production.
NEXT_PUBLIC_EXAMPLE_API_BASE=https://staging.freeinference.org
