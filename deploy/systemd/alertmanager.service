[Unit]
Description=Alertmanager
Wants=network-online.target
After=network-online.target home.mount

[Service]
User=freeinference
Group=freeinference
Type=simple
ExecStart=/srv/hybridInference/alertmanager-0.28.1.linux-amd64/alertmanager \
  --config.file=/srv/hybridInference/deploy/alertmanager/alertmanager.yml \
  --storage.path=/srv/hybridInference/var/alertmanager \
  --web.listen-address=0.0.0.0:9093 \
  --cluster.listen-address=""
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536

NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
