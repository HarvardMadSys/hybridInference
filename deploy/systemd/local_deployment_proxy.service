[Unit]
Description=local deployment proxy — lazy start/stop of GPU model containers
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=__REPO_ROOT__/ops/local_deployment_proxy
ExecStart=__REPO_ROOT__/.venv/bin/python3 __REPO_ROOT__/ops/local_deployment_proxy/local_deployment_proxy.py

Restart=on-failure
RestartSec=10s

Environment=LISTEN_PORT=8001
Environment=IDLE_TIMEOUT=1440
Environment=HEALTH_TIMEOUT=600
Environment=HEALTH_INTERVAL=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=local-deployment-proxy

[Install]
WantedBy=multi-user.target
