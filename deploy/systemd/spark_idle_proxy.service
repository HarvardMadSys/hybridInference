[Unit]
Description=spark idle proxy — lazy start/stop of vLLM model containers on DGX Spark
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=__REPO_ROOT__/ops/spark_idle_proxy
ExecStart=__REPO_ROOT__/.venv/bin/python3 __REPO_ROOT__/ops/spark_idle_proxy/spark_idle_proxy.py

Restart=on-failure
RestartSec=10s

Environment=LISTEN_PORT=8002
Environment=IDLE_TIMEOUT=1440
Environment=HEALTH_TIMEOUT=900
Environment=HEALTH_INTERVAL=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=spark-idle-proxy

[Install]
WantedBy=multi-user.target
