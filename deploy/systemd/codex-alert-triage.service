[Unit]
Description=HybridInference DeepSeek-backed Codex Alert Triage Relay
Wants=network-online.target
After=network-online.target

[Service]
User=codex-triage
Group=codex-triage
Type=simple
WorkingDirectory=/srv/hybridInference
EnvironmentFile=/etc/hybrid-inference/codex-triage.env
Environment=PYTHONPATH=/srv/hybridInference/apps/backend
Environment=CODEX_TRIAGE_REPOSITORY_PATH=/srv/hybridInference
Environment=CODEX_TRIAGE_STATE_DIR=/var/lib/hybrid-inference-codex-triage
Environment=CODEX_TRIAGE_CODEX_HOME=/var/lib/hybrid-inference-codex-triage/codex-home
ExecStart=/srv/hybridInference/.venv/bin/uvicorn serving.triage.app:app \
  --host 127.0.0.1 \
  --port 8091 \
  --no-server-header

Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=mixed

StateDirectory=hybrid-inference-codex-triage
UMask=0077
LimitCORE=0
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadOnlyPaths=/srv/hybridInference
ReadWritePaths=/var/lib/hybrid-inference-codex-triage
InaccessiblePaths=-/etc/hybrid-inference/codex-triage.env
InaccessiblePaths=-/srv/hybridInference/.env
InaccessiblePaths=-/srv/hybridInference/server.log
InaccessiblePaths=-/srv/hybridInference/var
InaccessiblePaths=-/srv/hybridInference/data
ProtectProc=ptraceable
ProcSubset=pid
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
