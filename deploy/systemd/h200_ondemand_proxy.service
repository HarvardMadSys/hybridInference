[Unit]
# On-demand multi-model proxy on an H200 box's spare GPU pair (0,1).
#
# The sibling h200_idle_proxy.service serves DeepSeek-V4-Flash on GPUs 2,3
# (port 8003 on h200a / 8004 on h200b). This unit runs a second
# ops/local_deployment_proxy instance on port 8006 serving the internal-only
# on-demand model set (ops/local_deployment_proxy/models.h200-ondemand.json):
# eight open-weight models, loaded lazily on GPUs 0,1 and stopped when idle.
#
# ALLOWED_GPUS=0,1 fences GPU auto-selection to this unit's pair, so it can
# never land a backend on the DeepSeek GPUs — and when both of its own devices
# are busy the proxy fails the request fast instead of launching onto a busy
# device (see the proxy README, "GPU auto-selection").
Description=H200 on-demand proxy — internal model set, lazy-loaded on GPUs 0,1
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=__REPO_ROOT__/ops/local_deployment_proxy

# MODELS_CONFIG is pinned with a `/usr/bin/env` prefix for the same reason as
# in the h200_idle_proxy units: this unit reads the gateway .env below,
# MODELS_CONFIG is also a *gateway* variable (a legacy alias of
# MODELS_CONFIG_PATH naming a YAML registry), and an EnvironmentFile= outranks
# every Environment= line whatever the order. Only a variable set in the child
# process, after systemd has finished compiling the environment, outranks
# EnvironmentFile=.
ExecStart=/usr/bin/env MODELS_CONFIG=__REPO_ROOT__/ops/local_deployment_proxy/models.h200-ondemand.json __REPO_ROOT__/.venv/bin/python3 __REPO_ROOT__/ops/local_deployment_proxy/local_deployment_proxy.py

Restart=on-failure
RestartSec=10s

# The gateway signs requests with the LOCAL_API_KEY from this .env, so reading
# the same file keeps both ends in step through a rotation. The leading '-'
# keeps the unit startable on a box with no .env — pass the key via a drop-in
# there (install writes local-api-key.conf), same as the other proxy units.
EnvironmentFile=-__REPO_ROOT__/.env

# PROXY_OWNER defaults to port-$LISTEN_PORT, so this unit's containers are
# stamped port-8006 and the DeepSeek proxy's port-8003/8004 — that is what
# stops the two proxies adopting or destroying each other's backends. See the
# "Container ownership" section of ops/local_deployment_proxy/README.md.
Environment=LISTEN_PORT=8006
Environment=IDLE_TIMEOUT=1440
Environment=HEALTH_TIMEOUT=900
Environment=HEALTH_INTERVAL=10
Environment=ALLOWED_GPUS=0,1
# Model weights land in each model's model_dir (/scratch/...); HF_HOME keeps
# hub metadata and any incidental cache off the root disk too. Gated repos
# (meta-llama, google, swiss-ai) additionally need HF_TOKEN with the licenses
# accepted — supply it via a drop-in (systemctl edit), never in this file.
Environment=HF_HOME=/scratch/yiyu/hf-cache

StandardOutput=journal
StandardError=journal
SyslogIdentifier=h200-ondemand-proxy

[Install]
WantedBy=multi-user.target
