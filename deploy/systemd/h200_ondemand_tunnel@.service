[Unit]
# Reverse SSH tunnel that exposes the h200_ondemand_proxy (port 8006 on this
# H200 box) to a router, binding port 8006 there so the router's backend
# container can reach the models at host.docker.internal:8006
# (H200B_ONDEMAND_DEPLOYMENT_URL in the gateway .env).
#
# Templated per router host: the instance name (%i) is the SSH destination, e.g.
#   systemctl enable --now h200_ondemand_tunnel@spark2
#   systemctl enable --now h200_ondemand_tunnel@jason@internal.freeinference.org
#
# BindsTo= for the same reason as h200_idle_tunnel@.service: a tunnel must not
# outlive the listener it advertises, or the router accepts connections and
# forwards them into nothing. Its counterpart is the Upholds= drop-in the
# installer writes on the proxy unit, so a proxy restarted after a crash brings
# its tunnels back with it.
Description=H200 on-demand reverse tunnel to %i (autossh)
Wants=network-online.target
BindsTo=h200_ondemand_proxy.service
After=network-online.target h200_ondemand_proxy.service

[Service]
Type=simple
User=root
Group=root

Environment=AUTOSSH_GATETIME=0
Environment=LISTEN_PORT=8006
Environment=REMOTE_PORT=8006
Environment=REMOTE_BIND=0.0.0.0
ExecStart=/usr/bin/autossh -M 0 -N \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=3 \
  -o ExitOnForwardFailure=yes \
  -R ${REMOTE_BIND}:${REMOTE_PORT}:localhost:${LISTEN_PORT} \
  %i

Restart=always
RestartSec=10s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=h200-ondemand-tunnel@%i

[Install]
WantedBy=multi-user.target
