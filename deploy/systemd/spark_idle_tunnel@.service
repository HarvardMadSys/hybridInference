[Unit]
# Reverse SSH tunnel that exposes spark_idle_proxy (port LISTEN_PORT on this DGX
# Spark) to a gateway host, binding REMOTE_PORT there so the gateway's backend
# container reaches the model at host.docker.internal:REMOTE_PORT.
#
# Templated per gateway host: the instance name (%i) is the SSH destination, e.g.
#   systemctl enable --now spark_idle_tunnel@jason@internal.freeinference.org
#
# Installed by ops/spark_idle_proxy/install_service.sh, which defaults to
# production. Staging needs no instance: the staging gateway runs on this same
# box, so it reaches the proxy's own 0.0.0.0:8002 directly.
#
# This unit exists because the tunnel used to be a bare `ssh -N -R` started by
# hand from spark_idle_service.sh. On 2026-08-06 that process exited and stayed
# dead: the proxy kept serving 200s locally, nothing bound 8002 on the gateway
# host, and every diffusiongemma request failed to connect until the breaker
# opened. autossh plus Restart=always is what that outage was missing.
Description=Spark idle reverse tunnel to %i (autossh)
Wants=network-online.target

# BindsTo= stops the tunnel when the proxy goes inactive *or* failed *or*
# disappears — including a crash, which no explicit systemctl action reports. A
# tunnel outliving its listener is the h200a failure written up in
# h200_idle_tunnel_b@.service: the gateway host accepted connections on the
# forwarded port, forwarded them, and every one died at the far end with nothing
# listening, which the breaker and the paid-API fallback turned into silent
# fallback spend rather than an alert.
#
# BindsTo= on its own is a trap, though, and the trap is *this* outage. The proxy
# sets Restart=on-failure, so a crash stops this tunnel and then brings the proxy
# straight back — and stop-propagation has no start-propagating counterpart, so the
# tunnel stays down. A healthy proxy behind a dead route is precisely the state
# that opened the breaker on 2026-08-06. The other half of the pair is an
# `Upholds=` on the proxy naming this instance, which install_service.sh writes as
# a drop-in, that being the only place the per-host instance name is known.
#
# Measured on spark2 (systemd 255) rather than reasoned about, because the obvious
# guesses are wrong in both directions: `systemctl restart <proxy>` does *not*
# propagate through BindsTo= (the tunnel stays up, so PartOf= buys nothing here),
# while `kill -9` of the proxy does (tunnel inactive, proxy active again). With the
# Upholds= drop-in, that same kill leaves both active.
BindsTo=spark_idle_proxy.service
After=network-online.target spark_idle_proxy.service

[Service]
Type=simple

# root by default to match the other tunnel units, but on this box root has no
# SSH key for the gateway host and `sudo ssh` there fails host key verification
# outright. install.sh writes a `User=` drop-in from TUNNEL_USER for exactly that
# reason; the Spark needs TUNNEL_USER=juncheng.
User=root
Group=root

# autossh's own startup gate. Without this it treats an early exit as "the first
# connection never worked, stop trying" — which on a box that boots before the
# network is routable is a tunnel that never appears.
Environment=AUTOSSH_GATETIME=0
Environment=LISTEN_PORT=8002
Environment=REMOTE_PORT=8002
Environment=REMOTE_BIND=0.0.0.0

# ExitOnForwardFailure turns a refused remote bind into a non-zero exit, so
# Restart=always retries it. Without it ssh stays connected while forwarding
# nothing, which looks healthy from here and is unreachable from the gateway.
ExecStart=/usr/bin/autossh -M 0 -N \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=3 \
  -o ExitOnForwardFailure=yes \
  -R ${REMOTE_BIND}:${REMOTE_PORT}:localhost:${LISTEN_PORT} \
  %i

Restart=always
RestartSec=10s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=spark-idle-tunnel@%i

[Install]
WantedBy=multi-user.target
