[Unit]
Description=H200 idle proxy — lazy start/stop of DeepSeek-V4-Flash NVFP4 (TP=2 on GPUs 2,3)
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=__REPO_ROOT__/ops/h200_idle_proxy

# MODELS_CONFIG is set here, on the command line, rather than with an
# Environment= line, because this unit reads the gateway .env below and
# MODELS_CONFIG is also a *gateway* variable (a legacy alias of
# MODELS_CONFIG_PATH — see the AliasChoices in
# apps/backend/serving/config/settings.py). An EnvironmentFile= outranks every
# Environment= line whatever the order (systemd.exec(5): "Settings from these
# files override settings made with Environment="), so a gateway .env naming a
# YAML registry would replace the pin below and this proxy would json.load()
# that YAML and come up with no backends.
#
# The sibling units answer that with UnsetEnvironment=MODELS_CONFIG, but this
# one has to *keep* a value: auto-detection resolves profiles relative to the
# script's own directory (ops/local_deployment_proxy), not this unit's
# WorkingDirectory, so dropping the pin would hand the choice of config to
# nvidia-smi. The pin is what makes this node serve the config named below
# whatever the hardware reports. `/usr/bin/env VAR=…` sets the variable in the
# child after systemd has compiled its environment, so it outranks
# EnvironmentFile= and UnsetEnvironment= both.
#
# The detector's 4+ x H200 branch now resolves to this very file, so both routes
# reach one DeepSeek config (TP=2 on GPUs 2,3) rather than two that can drift.
# It is still the same container name on the same backend_port either way: a
# second proxy on this host needs a config whose 'container' and 'backend_port'
# do not collide with it. Ownership labels turn a collision into a 502 naming
# both owners instead of two processes destroying each other's container — see
# ops/local_deployment_proxy/README.md, "Container ownership".
ExecStart=/usr/bin/env MODELS_CONFIG=__REPO_ROOT__/ops/h200_idle_proxy/models.json __REPO_ROOT__/.venv/bin/python3 __REPO_ROOT__/ops/local_deployment_proxy/local_deployment_proxy.py

Restart=on-failure
RestartSec=10s

# Both H200 nodes authenticate inbound gateway requests against LOCAL_API_KEY,
# and the gateway signs them with the LOCAL_API_KEY from this same .env (see the
# api_keys entries in distributions/freeinference/config/models.yaml). Reading
# one file keeps the two ends in step through a rotation; without it this unit
# could only ever use the default hardcoded in local_deployment_proxy.py, so the
# first rotation would 401 every request — and because deepseek-v4-flash carries
# a remote fallback, the H200s would drop out of rotation silently and the
# traffic would move to a paid provider.
#
# The leading '-' keeps the unit startable on a box with no .env; there
# ops/h200_idle_proxy/install.sh supplies the key as a drop-in instead.
EnvironmentFile=-__REPO_ROOT__/.env

Environment=LISTEN_PORT=8003
Environment=IDLE_TIMEOUT=1440
Environment=HEALTH_TIMEOUT=900
Environment=HEALTH_INTERVAL=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=h200-idle-proxy

[Install]
WantedBy=multi-user.target
