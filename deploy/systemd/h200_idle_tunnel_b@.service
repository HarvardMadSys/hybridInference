[Unit]
# Reverse SSH tunnel for replica B (h200_idle_proxy_b.service, port 8005 on this
# H200 box), exposing it on the router as REMOTE_PORT so the router's backend
# container reaches it at host.docker.internal:REMOTE_PORT.
#
# Templated per router host, the same way the replica A tunnel is:
#   systemctl enable --now h200_idle_tunnel_b@spark2
#   systemctl enable --now h200_idle_tunnel_b@jason@internal.freeinference.org
#
# Bound to the replica B proxy with BindsTo=, not just Wants=. The replica A
# tunnel uses Wants=, and h200a showed what that costs: its proxy was inactive
# for hours while both of its tunnels stayed up, so the router accepted
# connections on 8003, forwarded them, and every one failed at the node with
# nothing listening. The gateway's circuit breaker and the paid-API fallback hid
# it, so it surfaced as silent fallback spend rather than an alert. BindsTo=
# stops a tunnel outliving the listener it advertises.
Description=H200 idle reverse tunnel (replica B) to %i (autossh)
Wants=network-online.target
BindsTo=h200_idle_proxy_b.service
After=network-online.target h200_idle_proxy_b.service

[Service]
Type=simple
User=root
Group=root

Environment=AUTOSSH_GATETIME=0
Environment=LISTEN_PORT=8005
Environment=REMOTE_PORT=8005
Environment=REMOTE_BIND=0.0.0.0
ExecStart=/usr/bin/autossh -M 0 -N \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=3 \
  -o ExitOnForwardFailure=yes \
  -R ${REMOTE_BIND}:${REMOTE_PORT}:localhost:${LISTEN_PORT} \
  %i

Restart=always
RestartSec=10s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=h200-idle-tunnel-b@%i

[Install]
WantedBy=multi-user.target
