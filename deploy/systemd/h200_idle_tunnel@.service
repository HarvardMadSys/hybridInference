[Unit]
# Reverse SSH tunnel that exposes the h200_idle_proxy (port LISTEN_PORT on this
# H200 box) to a public router, binding REMOTE_PORT there so the router's
# backend container can reach the model at host.docker.internal:REMOTE_PORT.
#
# Templated per router host: the instance name (%i) is the SSH destination, e.g.
#   systemctl enable --now h200_idle_tunnel@spark2
#   systemctl enable --now h200_idle_tunnel@jason@internal.freeinference.org
#
# Defaults target staging (spark2) and production (internal.freeinference.org)
# on port 8003 (see ops/h200_idle_proxy/install.sh).
Description=H200 idle reverse tunnel to %i (autossh)
Wants=network-online.target

# BindsTo=, not the Wants= this unit used to carry. h200a showed what Wants=
# costs: its proxy was inactive for hours while both of its tunnels stayed up, so
# the router accepted connections on 8003, forwarded them, and every one failed at
# the node with nothing listening. The gateway's circuit breaker and the paid-API
# fallback hid it, so it surfaced as silent fallback spend rather than an alert.
# BindsTo= stops a tunnel outliving the listener it advertises, including when the
# proxy crashes rather than being stopped.
#
# It needs its counterpart to be safe: stop-propagation has no start-propagating
# opposite, so the proxy's own Restart=on-failure would bring the proxy back from a
# crash and leave this tunnel stopped — the Spark's 2026-08-06 outage exactly, a
# healthy proxy behind a dead route. install.sh writes the matching `Upholds=`
# drop-in on the proxy, which is the only place the per-host instance name exists.
BindsTo=h200_idle_proxy.service
After=network-online.target h200_idle_proxy.service

[Service]
Type=simple
User=root
Group=root

Environment=AUTOSSH_GATETIME=0
Environment=LISTEN_PORT=8003
Environment=REMOTE_PORT=8003
Environment=REMOTE_BIND=0.0.0.0
ExecStart=/usr/bin/autossh -M 0 -N \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=3 \
  -o ExitOnForwardFailure=yes \
  -R ${REMOTE_BIND}:${REMOTE_PORT}:localhost:${LISTEN_PORT} \
  %i

Restart=always
RestartSec=10s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=h200-idle-tunnel@%i

[Install]
WantedBy=multi-user.target
