# ---- Stage 1: dependencies ----
FROM node:22-alpine AS deps
WORKDIR /app
COPY apps/frontend/package.json apps/frontend/package-lock.json ./
RUN npm ci

# ---- Stage 2: build ----
FROM node:22-alpine AS builder
WORKDIR /app
ARG NEXT_PUBLIC_API_BASE=https://freeinference.org
ARG NEXT_PUBLIC_DEPLOY_TARGET=production
ARG NEXT_PUBLIC_BUILD_SHA=
ARG NEXT_PUBLIC_BUILD_TIMESTAMP=
ARG NEXT_PUBLIC_TURNSTILE_SITE_KEY=
ARG NEXT_PUBLIC_APP_NAME=
ARG NEXT_PUBLIC_APP_DESCRIPTION=
ARG NEXT_PUBLIC_SITE_HOST=
ARG NEXT_PUBLIC_ORG_NAME=
ARG NEXT_PUBLIC_ORG_URL=
ARG NEXT_PUBLIC_ORG_TAGLINE=
ARG NEXT_PUBLIC_DOCS_URL=
ARG NEXT_PUBLIC_STATUS_URL=
ARG NEXT_PUBLIC_GITHUB_URL=
ARG NEXT_PUBLIC_CONTACT_EMAIL=
ARG NEXT_PUBLIC_EXAMPLE_API_BASE=
ARG NEXT_PUBLIC_EXAMPLE_API_KEY_ENV_VAR=
ARG NEXT_PUBLIC_EXAMPLE_MODEL=
ARG NEXT_PUBLIC_STATCOUNTER_PROJECT_ID=13224568
ARG NEXT_PUBLIC_STATCOUNTER_SECURITY_KEY=2d8ab84a
ARG NEXT_PUBLIC_FAST_TRACK_DOMAIN=harvard.edu
ARG NEXT_PUBLIC_FAST_TRACK_ORG=Harvard
ARG NEXT_PUBLIC_STORAGE_KEY_PREFIX=
ARG NEXT_PUBLIC_TEAM_JSON=
ARG NEXT_PUBLIC_SPONSORS_JSON=
ARG NEXT_PUBLIC_TEAM_IMAGE_HOST=
ENV NEXT_PUBLIC_API_BASE=$NEXT_PUBLIC_API_BASE
ENV NEXT_PUBLIC_DEPLOY_TARGET=$NEXT_PUBLIC_DEPLOY_TARGET
ENV NEXT_PUBLIC_BUILD_SHA=$NEXT_PUBLIC_BUILD_SHA
ENV NEXT_PUBLIC_BUILD_TIMESTAMP=$NEXT_PUBLIC_BUILD_TIMESTAMP
ENV NEXT_PUBLIC_TURNSTILE_SITE_KEY=$NEXT_PUBLIC_TURNSTILE_SITE_KEY
ENV NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME
ENV NEXT_PUBLIC_APP_DESCRIPTION=$NEXT_PUBLIC_APP_DESCRIPTION
ENV NEXT_PUBLIC_SITE_HOST=$NEXT_PUBLIC_SITE_HOST
ENV NEXT_PUBLIC_ORG_NAME=$NEXT_PUBLIC_ORG_NAME
ENV NEXT_PUBLIC_ORG_URL=$NEXT_PUBLIC_ORG_URL
ENV NEXT_PUBLIC_ORG_TAGLINE=$NEXT_PUBLIC_ORG_TAGLINE
ENV NEXT_PUBLIC_DOCS_URL=$NEXT_PUBLIC_DOCS_URL
ENV NEXT_PUBLIC_STATUS_URL=$NEXT_PUBLIC_STATUS_URL
ENV NEXT_PUBLIC_GITHUB_URL=$NEXT_PUBLIC_GITHUB_URL
ENV NEXT_PUBLIC_CONTACT_EMAIL=$NEXT_PUBLIC_CONTACT_EMAIL
ENV NEXT_PUBLIC_EXAMPLE_API_BASE=$NEXT_PUBLIC_EXAMPLE_API_BASE
ENV NEXT_PUBLIC_EXAMPLE_API_KEY_ENV_VAR=$NEXT_PUBLIC_EXAMPLE_API_KEY_ENV_VAR
ENV NEXT_PUBLIC_EXAMPLE_MODEL=$NEXT_PUBLIC_EXAMPLE_MODEL
ENV NEXT_PUBLIC_STATCOUNTER_PROJECT_ID=$NEXT_PUBLIC_STATCOUNTER_PROJECT_ID
ENV NEXT_PUBLIC_STATCOUNTER_SECURITY_KEY=$NEXT_PUBLIC_STATCOUNTER_SECURITY_KEY
ENV NEXT_PUBLIC_FAST_TRACK_DOMAIN=$NEXT_PUBLIC_FAST_TRACK_DOMAIN
ENV NEXT_PUBLIC_FAST_TRACK_ORG=$NEXT_PUBLIC_FAST_TRACK_ORG
ENV NEXT_PUBLIC_STORAGE_KEY_PREFIX=$NEXT_PUBLIC_STORAGE_KEY_PREFIX
ENV NEXT_PUBLIC_TEAM_JSON=$NEXT_PUBLIC_TEAM_JSON
ENV NEXT_PUBLIC_SPONSORS_JSON=$NEXT_PUBLIC_SPONSORS_JSON
ENV NEXT_PUBLIC_TEAM_IMAGE_HOST=$NEXT_PUBLIC_TEAM_IMAGE_HOST
COPY --from=deps /app/node_modules node_modules
COPY apps/frontend/ .
RUN npm run build

# ---- Stage 3: runtime ----
FROM node:22-alpine
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3001
ENV HOSTNAME=0.0.0.0

# Copy standalone output (requires output: 'standalone' in next.config.js)
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static .next/static
COPY --from=builder /app/public public

EXPOSE 3001

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:3001/ || exit 1

CMD ["node", "server.js"]
