# ---- Stage 1: dependencies ----
FROM node:22-alpine@sha256:b6f26b36c8ff49624cfdac716b8ea1138d606df02586a77d364bb5536a634f85 AS deps
WORKDIR /app
COPY apps/frontend/package.json apps/frontend/package-lock.json ./
RUN npm ci

# An optional named context replaces this marker-only stage with a module.
# Without --build-context site-ui=..., the existing neutral build is selected.
FROM scratch AS site-ui
COPY deploy/docker/site-ui/.built-in-ui /.built-in-ui

# ---- Stage 3: build ----
FROM node:22-alpine@sha256:b6f26b36c8ff49624cfdac716b8ea1138d606df02586a77d364bb5536a634f85 AS builder
WORKDIR /app

# Public build settings remain compatible with existing neutral deployments.
# Explicitly empty NEXT_PUBLIC_API_BASE selects same-origin Next.js rewrites.
ARG NEXT_PUBLIC_API_BASE=http://localhost:8080
# Next loads .env files during `next build`, but this explicit process env has
# higher precedence and pins the server-side rewrite target deterministically.
ARG BACKEND_INTERNAL_URL=http://backend:8080

# Compatibility bridge for legacy branded images: when both values are passed
# as build args, Next compiles the old beforeFiles rewrites into its routes
# manifest. Neutral images leave them empty and the Node route handler reads
# the same server-only names at container runtime instead.
ARG AGENT_WEB_INTERNAL_URL=
ARG AGENT_CONTROL_PLANE_INTERNAL_URL=
ARG NEXT_PUBLIC_DEPLOY_TARGET=production
ARG NEXT_PUBLIC_BUILD_SHA=
ARG NEXT_PUBLIC_BUILD_TIMESTAMP=
ARG NEXT_PUBLIC_TURNSTILE_SITE_KEY=
ARG NEXT_PUBLIC_APP_NAME=
ARG NEXT_PUBLIC_APP_DESCRIPTION=
ARG NEXT_PUBLIC_SITE_HOST=
ARG NEXT_PUBLIC_ORG_NAME=
ARG NEXT_PUBLIC_ORG_URL=
ARG NEXT_PUBLIC_ORG_TAGLINE=
ARG NEXT_PUBLIC_DOCS_URL=
ARG NEXT_PUBLIC_STATUS_URL=
ARG NEXT_PUBLIC_GITHUB_URL=
ARG NEXT_PUBLIC_CONTACT_EMAIL=
ARG NEXT_PUBLIC_EXAMPLE_API_BASE=
ARG NEXT_PUBLIC_EXAMPLE_API_KEY_ENV_VAR=
ARG NEXT_PUBLIC_EXAMPLE_MODEL=
ARG NEXT_PUBLIC_STATCOUNTER_PROJECT_ID=
ARG NEXT_PUBLIC_STATCOUNTER_SECURITY_KEY=
ARG NEXT_PUBLIC_FAST_TRACK_DOMAIN=
ARG NEXT_PUBLIC_FAST_TRACK_ORG=
ARG NEXT_PUBLIC_STORAGE_KEY_PREFIX=
ARG NEXT_PUBLIC_DATA_POLICY_NOTICE=
ARG NEXT_PUBLIC_TEAM_JSON=
ARG NEXT_PUBLIC_SPONSORS_JSON=
ENV NEXT_PUBLIC_API_BASE=$NEXT_PUBLIC_API_BASE
ENV BACKEND_INTERNAL_URL=$BACKEND_INTERNAL_URL
ENV AGENT_WEB_INTERNAL_URL=$AGENT_WEB_INTERNAL_URL
ENV AGENT_CONTROL_PLANE_INTERNAL_URL=$AGENT_CONTROL_PLANE_INTERNAL_URL
ENV NEXT_PUBLIC_DEPLOY_TARGET=$NEXT_PUBLIC_DEPLOY_TARGET
ENV NEXT_PUBLIC_BUILD_SHA=$NEXT_PUBLIC_BUILD_SHA
ENV NEXT_PUBLIC_BUILD_TIMESTAMP=$NEXT_PUBLIC_BUILD_TIMESTAMP
ENV NEXT_PUBLIC_TURNSTILE_SITE_KEY=$NEXT_PUBLIC_TURNSTILE_SITE_KEY
ENV NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME
ENV NEXT_PUBLIC_APP_DESCRIPTION=$NEXT_PUBLIC_APP_DESCRIPTION
ENV NEXT_PUBLIC_SITE_HOST=$NEXT_PUBLIC_SITE_HOST
ENV NEXT_PUBLIC_ORG_NAME=$NEXT_PUBLIC_ORG_NAME
ENV NEXT_PUBLIC_ORG_URL=$NEXT_PUBLIC_ORG_URL
ENV NEXT_PUBLIC_ORG_TAGLINE=$NEXT_PUBLIC_ORG_TAGLINE
ENV NEXT_PUBLIC_DOCS_URL=$NEXT_PUBLIC_DOCS_URL
ENV NEXT_PUBLIC_STATUS_URL=$NEXT_PUBLIC_STATUS_URL
ENV NEXT_PUBLIC_GITHUB_URL=$NEXT_PUBLIC_GITHUB_URL
ENV NEXT_PUBLIC_CONTACT_EMAIL=$NEXT_PUBLIC_CONTACT_EMAIL
ENV NEXT_PUBLIC_EXAMPLE_API_BASE=$NEXT_PUBLIC_EXAMPLE_API_BASE
ENV NEXT_PUBLIC_EXAMPLE_API_KEY_ENV_VAR=$NEXT_PUBLIC_EXAMPLE_API_KEY_ENV_VAR
ENV NEXT_PUBLIC_EXAMPLE_MODEL=$NEXT_PUBLIC_EXAMPLE_MODEL
ENV NEXT_PUBLIC_STATCOUNTER_PROJECT_ID=$NEXT_PUBLIC_STATCOUNTER_PROJECT_ID
ENV NEXT_PUBLIC_STATCOUNTER_SECURITY_KEY=$NEXT_PUBLIC_STATCOUNTER_SECURITY_KEY
ENV NEXT_PUBLIC_FAST_TRACK_DOMAIN=$NEXT_PUBLIC_FAST_TRACK_DOMAIN
ENV NEXT_PUBLIC_FAST_TRACK_ORG=$NEXT_PUBLIC_FAST_TRACK_ORG
ENV NEXT_PUBLIC_STORAGE_KEY_PREFIX=$NEXT_PUBLIC_STORAGE_KEY_PREFIX
ENV NEXT_PUBLIC_DATA_POLICY_NOTICE=$NEXT_PUBLIC_DATA_POLICY_NOTICE
ENV NEXT_PUBLIC_TEAM_JSON=$NEXT_PUBLIC_TEAM_JSON
ENV NEXT_PUBLIC_SPONSORS_JSON=$NEXT_PUBLIC_SPONSORS_JSON
COPY --from=deps /app/node_modules node_modules
COPY apps/frontend/ .

# Which module, if any. `SITE_UI_SUBDIR` names the module inside the context, so
# a repository can pass its whole `frontend/` tree and point at `site-ui` rather
# than arranging a context that contains only the module. `SITE_UI_API` is
# required with an external module and checked against this checkout's revision
# by the resolver — an unset value is a build failure, not a fallback. Either one
# given without `--build-context site-ui=...` is refused as well: the neutral UI
# is what a build with no module settings produces, not a stand-in for a module
# whose context went missing.
ARG SITE_UI_SUBDIR=.
ARG SITE_UI_API=

# Buildx substitutes the named context at this COPY; only packaged output
# reaches the runtime image.
COPY --from=site-ui / /tmp/site-ui-context/

# Stage the module inside the application before building. The application then
# compiles it from a path it owns, the resolver writes its bridge and tsconfig
# there, and the mounted context is not read again. It stays in the layer
# because a `COPY` cannot be undone in place; the runtime stage copies only the
# standalone tree, so nothing from it ships.
RUN node scripts/site-ui/prepare-module.mjs prepare \
      --app /app \
      --context /tmp/site-ui-context \
      --subdir "${SITE_UI_SUBDIR}" \
      --into /app/src/site-ui/external \
      --api "${SITE_UI_API}"

# The staging step wrote which module it prepared — or an empty value, for the
# neutral build — and sourcing that file is what carries the decision into the
# build. An unset value is the neutral UI, which is the behaviour this
# Dockerfile had before modules existed.
#
# `next build` runs the resolver itself (see `next.config.js`), so a module that
# reached this point and cannot be compiled still fails here rather than
# producing a neutral image by accident.
RUN if [ -f .site-ui-build-env ]; then set -a; . ./.site-ui-build-env; set +a; fi; npm run build

# Finish the bundle. `manifest` copies the compiled chunks into the standalone
# tree and records which module was compiled in — `next build` writes `src/`, and
# the standalone tree does not include it. `merge` copies the application's
# public files and packages the module's own assets in `site-assets/` beside the
# server — not in `public/`, which Next serves before any route — so only the
# `/site-assets` route serves them, after a deployment's `SITE_ASSETS_DIR`. It is
# also where a collision with the application's files becomes a build failure
# rather than a silent overwrite.
# `check` then asserts the finished bundle: `output: 'standalone'` omits the
# chunks, and the runtime stage used to copy them separately, so the bundle was
# produced in one place and asserted in another.
#
# `merge` runs after the build because it reads the module id from the manifest
# the build wrote — the resolver decides what the module is, and the assets have
# to land under the id the *build* recorded rather than one a Dockerfile guessed.
RUN node scripts/site-ui/prepare-module.mjs merge --repo-root . --app . \
 && node scripts/site-ui/prepare-module.mjs manifest --repo-root . --app . \
 && node scripts/site-ui/prepare-module.mjs check --repo-root . --app .

# ---- Stage 4: runtime ----
FROM node:22-alpine@sha256:b6f26b36c8ff49624cfdac716b8ea1138d606df02586a77d364bb5536a634f85
WORKDIR /app

# `PORT` and `HOSTNAME` are what the standalone server binds. Without them Next
# listens on `localhost:3000`, which is inside the container's own network
# namespace — the image starts, logs `Ready`, and answers nothing from outside.
# They were in this file before the Site UI stages were added and were lost in
# that edit, which is exactly the kind of regression a composability change
# causes: the new stages were the subject of the diff and the runtime stage was
# rewritten around them.
ENV NODE_ENV=production
ENV PORT=3001
ENV HOSTNAME=0.0.0.0

# Identity declarations used by release tooling alongside source attestations.
# Labels default to empty strings for a neutral build. Labels alone do not prove
# which sources were compiled; publication must verify the build's provenance.
ARG OCI_SOURCE=""
ARG OCI_REVISION=""
ARG CORE_REVISION=""
ARG SITE_UI_API=""
ARG FRONTEND_INPUTS_TREE=""

LABEL org.opencontainers.image.source="$OCI_SOURCE" \
      org.opencontainers.image.revision="$OCI_REVISION" \
      io.hybridinference.core-revision="$CORE_REVISION" \
      io.hybridinference.site-ui-api="$SITE_UI_API" \
      io.hybridinference.frontend-inputs-tree="$FRONTEND_INPUTS_TREE"

# One copy, because the builder step above produced one complete tree: the
# standalone server, the compiled chunks, the application's public files, the
# module's packaged assets and the module record beside the server.
COPY --from=builder /app/.next/standalone ./

EXPOSE 3001

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:3001/ || exit 1

CMD ["node", "server.js"]
