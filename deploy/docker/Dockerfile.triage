# syntax=docker/dockerfile:1.7
#
# Codex alert-triage relay. The relay only receives alerts, posts them to
# Slack, and hands analysis to the codex-triage GitHub Actions workflow via
# repository_dispatch — Codex itself, Node, and the repository snapshot are
# deliberately NOT part of this image.

FROM python:3.12-slim AS python-builder

RUN pip install --no-cache-dir uv

WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project --no-install-package routewise

FROM python:3.12-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 triage \
    && useradd --uid 10001 --gid triage --create-home \
        --home-dir /var/lib/codex-triage --shell /usr/sbin/nologin triage \
    && install -d -o triage -g triage -m 0700 /var/lib/codex-triage

COPY --from=python-builder /app/.venv /app/.venv
COPY apps/backend/serving /app/apps/backend/serving

ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONPATH=/app/apps/backend \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/var/lib/codex-triage \
    CODEX_TRIAGE_STATE_DIR=/var/lib/codex-triage

WORKDIR /app
USER triage

EXPOSE 8091

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fsS http://localhost:8091/healthz | grep -q '"ready":true'

CMD ["uvicorn", "serving.triage.app:app", \
     "--host", "0.0.0.0", "--port", "8091", "--no-server-header"]
