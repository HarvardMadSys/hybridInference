#!/usr/bin/env python3
"""Point Kilo Code at this deployment's gateway, then run it.

Kilo's CLI is an OpenCode fork and inherits its two gaps: it does not honour
``OPENAI_BASE_URL``, and its startup normally fetches the models.dev catalog —
which in the deny-all sandbox fails every time. This wrapper closes both the
same way the ``opencode-freeinference`` wrapper does: it writes a ``KILO_CONFIG``
file declaring a ``freeinference`` provider over the **bundled**
``@ai-sdk/openai-compatible`` package (compiled into the CLI binary — nothing is
downloaded at run time), disables the catalog fetch and the fork's additional
phone-home paths (PostHog telemetry, session ingest to app.kilo.ai, share
links, presence), and ``exec``s the real CLI with argv passed through untouched.

Ships in the sandbox image (reviewed and pinned there, like the CLI itself).
Same properties as the pi/opencode wrappers, deliberately:

- **The prompt never passes through a shell.** argv in, argv out, one exec.
- **The config lives in the container's HOME, not the job worktree** — a file
  dropped in the worktree would surface in ``git diff`` and pollute the patch.
- **json.dump does the quoting**, so a model id or URL cannot corrupt it.
"""

import json
import os
import sys


def main() -> None:
    """Write Kilo's provider config from the environment and exec it."""
    try:
        base_url = os.environ["OPENAI_BASE_URL"]
        api_key = os.environ["OPENAI_API_KEY"]
        model = os.environ["KILO_GATEWAY_MODEL"]
    except KeyError as missing:
        sys.stderr.write(
            f"kilo-freeinference: {missing.args[0]} is not set; this wrapper "
            "is meant to be launched by the agent runner, which supplies it.\n"
        )
        raise SystemExit(64) from None

    config_path = os.path.expanduser("~/.kilo-freeinference.json")
    config = {
        "provider": {
            "freeinference": {
                # Bundled in the kilo binary; with the catalog fetch disabled
                # below, nothing here needs the network.
                "npm": "@ai-sdk/openai-compatible",
                "name": "FreeInference",
                "options": {"baseURL": base_url, "apiKey": api_key},
                # The catalog is off, so the model must be declared or every
                # run dies with ProviderModelNotFoundError.
                "models": {model: {"name": model}},
            }
        }
    }
    with open(config_path, "w", encoding="utf-8") as handle:
        json.dump(config, handle)

    os.environ.update(
        {
            "KILO_CONFIG": config_path,
            # Kilo otherwise merges the repository's `kilo.json` and `.kilo/`
            # after this reviewed config. Those sources can declare local MCP
            # commands. Its supported kill switch covers both project forms.
            "KILO_DISABLE_PROJECT_CONFIG": "1",
            # Startup otherwise fetches the models.dev catalog and hard-fails
            # without it — in the sandbox that is every run, as a timeout that
            # reads like a broken model.
            "KILO_DISABLE_MODELS_FETCH": "1",
            "KILO_DISABLE_AUTOUPDATE": "1",
            # Default plugins are installed from npm at startup; the sandbox
            # has no route to a registry, so loading them must not be tried.
            "KILO_DISABLE_DEFAULT_PLUGINS": "1",
            # Fork-specific network paths beyond the OpenCode set, all pointed
            # at kilo.ai or PostHog; each has a supported kill switch (found by
            # inspecting the pinned binary — see the PR that added this file).
            "KILO_DISABLE_LSP_DOWNLOAD": "1",
            "KILO_DISABLE_SESSION_INGEST": "1",
            "KILO_DISABLE_SHARE": "1",
            "KILO_DISABLE_PRESENCE": "1",
            "KILO_DISABLE_CODEBASE_INDEXING": "1",
            "KILO_DISABLE_EMBEDDED_WEB_UI": "1",
            # Telemetry is enabled unless the level says otherwise; "off" is
            # any value other than "all" in the pinned build, and DO_NOT_TRACK
            # is honoured as a second, standard signal.
            "KILO_TELEMETRY_LEVEL": "off",
            "DO_NOT_TRACK": "1",
        }
    )
    os.execvp("kilo", ["kilo", *sys.argv[1:]])


if __name__ == "__main__":
    main()
