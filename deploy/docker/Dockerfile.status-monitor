# ---- Stage 1: build ----
FROM python:3.12-slim AS builder

RUN pip install uv

WORKDIR /app/status-monitor
COPY services/status-monitor/pyproject.toml services/status-monitor/uv.lock services/status-monitor/README.md ./
COPY services/status-monitor/src ./src
RUN uv sync --frozen --no-dev

# ---- Stage 2: runtime ----
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/status-monitor

COPY --from=builder /app/status-monitor/.venv .venv
COPY services/status-monitor/src ./src

ENV PATH="/app/status-monitor/.venv/bin:$PATH"
ENV PYTHONPATH="/app/status-monitor/src"

EXPOSE 9101

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:9101/api/health || exit 1

CMD ["python", "-m", "status_monitor", "--config", "/app/config.yml"]
