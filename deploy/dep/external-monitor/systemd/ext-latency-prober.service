[Unit]
Description=LLM Latency Prober (External)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Secrets (FREEINFERENCE_API_KEY etc.) go in this file, one KEY=value per line.
# Create it with: sudo nano /etc/external-monitor/latency-prober.env
EnvironmentFile=/etc/external-monitor/latency-prober.env
ExecStart=/usr/local/bin/python3 \
    /etc/external-monitor/latency-prober/prober.py \
    /etc/external-monitor/latency-prober/config.yml
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
